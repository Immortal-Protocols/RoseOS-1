--- a/external/hardened_malloc/Android.bp
+++ b/external/hardened_malloc/Android.bp
@@ -24,16 +24,33 @@
     "-DREGION_QUARANTINE_QUEUE_LENGTH=1024",
     "-DREGION_QUARANTINE_SKIP_THRESHOLD=33554432", // 32MiB
     "-DFREE_SLABS_QUARANTINE_RANDOM_LENGTH=32",
-    "-DCONFIG_CLASS_REGION_SIZE=34359738368", // 32GiB
     "-DN_ARENA=1",
     "-DCONFIG_STATS=true",
     "-DCONFIG_SELF_INIT=false",
 ]
 
-cc_defaults {
+// Stock-kernel ports may have a smaller userspace VA range than Graphene kernels.
+// The default stays unchanged; a device can explicitly select a compatible size.
+soong_config_module_type {
+    name: "hardened_malloc_cc_defaults",
+    module_type: "cc_defaults",
+    config_namespace: "hardened_malloc",
+    value_variables: ["class_region_size"],
+    properties: ["cflags"],
+}
+
+hardened_malloc_cc_defaults {
     name: "hardened_malloc_defaults",
     defaults: ["linux_bionic_supported"],
     cflags: common_cflags,
+    soong_config_variables: {
+        class_region_size: {
+            cflags: ["-DCONFIG_CLASS_REGION_SIZE=%s"],
+            conditions_default: {
+                cflags: ["-DCONFIG_CLASS_REGION_SIZE=34359738368"], // 32GiB
+            },
+        },
+    },
     conlyflags: ["-std=c23", "-Wmissing-prototypes"],
     stl: "none",
 }
--- a/vendor/google_devices/yogi/BoardConfig.mk
+++ b/vendor/google_devices/yogi/BoardConfig.mk
@@ -121,3 +121,7 @@
 
 # needed for partially backporting multi-partition libraries
 BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
+
+# Yogi stock kernel has 39-bit VA / 3-level page tables. Use the historical
+# arm64 hardened_malloc class-region size; leave all allocator guards enabled.
+$(call soong_config_set,hardened_malloc,class_region_size,2147483648)
