+    /** RoseOS: the preinstalled Rose Agent, the one system app allowed to install a newer build of itself. */
+    private static final String ROSE_AGENT_PACKAGE = "dev.pixel.voice";
+
+    /**
+     * RoseOS (issue #202): true only when Rose Agent updates itself. The session is a full, non-staged, non-APEX
+     * install of {@link #ROSE_AGENT_PACKAGE}, its owner is the installed package's own app id (the authenticated
+     * session uid, not a claimed installer or initiating package name), the APK is signed exactly as the installed
+     * package and its version code is higher. Every other system-app update stays blocked.
+     */
+    @GuardedBy("mLock")
+    private boolean isRoseAgentSelfUpdateLocked(PackageStateInternal existing) {
+        return ROSE_AGENT_PACKAGE.equals(mPackageName)
+                && ROSE_AGENT_PACKAGE.equals(existing.getPackageName())
+                && params.mode == SessionParams.MODE_FULL_INSTALL
+                && !params.isStaged
+                && !isApexSession()
+                && !existing.hasSharedUser()
+                && UserHandle.getAppId(mInstallerUid) == existing.getAppId()
+                && mSigningDetails != SigningDetails.UNKNOWN
+                && existing.getSigningDetails() != SigningDetails.UNKNOWN
+                && mSigningDetails.signaturesMatchExactly(existing.getSigningDetails())
+                && mVersionCode > existing.getVersionCode();
+    }
