+    /** The public release list, read anonymously (bounded pages and bytes), reduced to RoseReleases' input. */
+    private RoseReleases.Choice resolveRelease(final Network network, final String index, final String channel)
+            throws IOException {
+        final List<RoseReleases.Release> releases = new ArrayList<>();
+        for (int page = 1; page <= RoseReleases.MAX_PAGES; page++) {
+            final HttpsURLConnection connection =
+                    (HttpsURLConnection) network.openConnection(new URL(RoseReleases.page(index, page)));
+            connection.setSSLSocketFactory(tlsSocketFactory);
+            connection.setConnectTimeout(CONNECT_TIMEOUT);
+            connection.setReadTimeout(READ_TIMEOUT);
+            connection.setInstanceFollowRedirects(false);
+            connection.setRequestProperty("Accept", "application/vnd.github+json");
+            try {
+                final int status = connection.getResponseCode();
+                if (status != 200) {
+                    throw new IOException("release list unavailable (" + status + ")");
+                }
+                final JSONArray list;
+                try (final InputStream input = connection.getInputStream()) {
+                    final byte[] body = input.readNBytes(2 * 1024 * 1024 + 1);
+                    if (body.length > 2 * 1024 * 1024) throw new IOException("release list too large");
+                    list = new JSONArray(new String(body, java.nio.charset.StandardCharsets.UTF_8));
+                }
+                for (int i = 0; i < list.length(); i++) {
+                    final JSONObject release = list.getJSONObject(i);
+                    final List<RoseReleases.Asset> assets = new ArrayList<>();
+                    final JSONArray files = release.optJSONArray("assets");
+                    for (int j = 0; files != null && j < files.length(); j++) {
+                        final JSONObject asset = files.getJSONObject(j);
+                        assets.add(new RoseReleases.Asset(asset.optString("name", null), asset.optString("state", null)));
+                    }
+                    releases.add(new RoseReleases.Release(release.optString("tag_name", null),
+                            release.optBoolean("draft", true), assets));
+                }
+                if (list.length() < RoseReleases.PER_PAGE) {
+                    return RoseReleases.choose(releases, true, DEVICE, channel, INCREMENTAL);
+                }
+            } catch (JSONException e) {
+                throw new IOException("release list unreadable");
+            } finally {
+                connection.disconnect();
+            }
+        }
+        return RoseReleases.choose(releases, false, DEVICE, channel, INCREMENTAL);
+    }
