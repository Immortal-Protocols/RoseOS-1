@@ -0,0 +1,81 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package android.companion.virtual.computercontrol;
+
+import android.annotation.NonNull;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * RoseOS (#156): the apps currently on one ComputerControl session's own device, as the platform's automated-package
+ * repository holds them, read for that session's owner only (IComputerControlSession#getAutomatedApps).
+ *
+ * <p>packageNames: the distinct packages, sorted, with a non-finishing activity of the owner's user on the session's
+ * device, front or hidden. A finished logical task removes nothing; an app leaves only when its activities finish or
+ * move off the device (for example handOverApplications). complete: false when the device also runs another user's
+ * activity, which is never reported here. An empty complete list is a genuinely empty device.
+ *
+ * <p>generation: rises with every change to this device's apps or completeness, and never decreases for one session.
+ * closed: the session is closed (caller close, binder death, timeout, empty session or device close); then
+ * packageNames is empty, generation is {@link Long#MAX_VALUE} and every later read is the same, so a closed session
+ * never reports apps again. A replacement session has its own device and its own reads.
+ *
+ * @hide
+ */
+public final class AutomatedApps implements Parcelable {
+    private final long mGeneration;
+    @NonNull private final String[] mPackageNames;
+    private final int mUserId;
+    private final boolean mComplete;
+    private final boolean mClosed;
+
+    public AutomatedApps(long generation, @NonNull String[] packageNames, int userId, boolean complete,
+            boolean closed) {
+        mGeneration = generation;
+        mPackageNames = packageNames.clone();
+        mUserId = userId;
+        mComplete = complete;
+        mClosed = closed;
+    }
+
+    /** The closed, terminal state. */
+    @NonNull
+    public static AutomatedApps closed(int userId) {
+        return new AutomatedApps(Long.MAX_VALUE, new String[0], userId, true, true);
+    }
+
+    public long getGeneration() { return mGeneration; }
+    @NonNull public String[] getPackageNames() { return mPackageNames.clone(); }
+    public int getUserId() { return mUserId; }
+    public boolean isComplete() { return mComplete; }
+    public boolean isClosed() { return mClosed; }
+
+    private AutomatedApps(Parcel in) {
+        mGeneration = in.readLong();
+        mPackageNames = in.createStringArray();
+        mUserId = in.readInt();
+        mComplete = in.readBoolean();
+        mClosed = in.readBoolean();
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeLong(mGeneration);
+        dest.writeStringArray(mPackageNames);
+        dest.writeInt(mUserId);
+        dest.writeBoolean(mComplete);
+        dest.writeBoolean(mClosed);
+    }
+
+    @Override
+    public int describeContents() { return 0; }
+
+    @NonNull
+    public static final Creator<AutomatedApps> CREATOR = new Creator<>() {
+        @Override public AutomatedApps createFromParcel(Parcel in) { return new AutomatedApps(in); }
+        @Override public AutomatedApps[] newArray(int size) { return new AutomatedApps[size]; }
+    };
+}
