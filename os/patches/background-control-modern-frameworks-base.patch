+import java.util.List;
+import java.util.Objects;
+import java.util.function.BooleanSupplier;
+import java.util.function.Predicate;
+
+/**
+ * RoseOS (multi-session): ComputerControlSessionProcessor's session admission rules, kept free of Android state.
+ *
+ * <p>The pinned limit (MAXIMUM_CONCURRENT_SESSIONS) still counts every owner's sessions. The one exception is the
+ * signer-pinned prototype owner (ComputerControlAllowlistController#hasPrototypeControl): it may hold a second
+ * session, but only when the one session already held is its own, with the same owner uid, and that owner also
+ * passes the check. A session of any other owner never sits next to it, and no owner gets a third session. A
+ * session whose close failed is still held and still counts.
+ */
+final class ComputerControlSessionAdmission {
+    /** The most sessions one signer-pinned prototype owner uid may hold at once. */
+    static final int MAXIMUM_PROTOTYPE_OWNER_SESSIONS = 2;
+
+    private ComputerControlSessionAdmission() {}
+
+    /** One session already counted: its owner and name, and whether its owner passes the prototype check. */
+    static final class Held {
+        final int ownerUid;
+        @NonNull final String ownerPackageName;
+        @Nullable final String name;
+        @NonNull private final BooleanSupplier mPrototypeOwner;
+
+        Held(int ownerUid, @NonNull String ownerPackageName, @Nullable String name,
+                @NonNull BooleanSupplier prototypeOwner) {
+            this.ownerUid = ownerUid;
+            this.ownerPackageName = ownerPackageName;
+            this.name = name;
+            mPrototypeOwner = prototypeOwner;
+        }
+
+        boolean isPrototypeOwner() {
+            return mPrototypeOwner.getAsBoolean();
+        }
+    }
+
+    /**
+     * Whether a new session for requesterUid may be created next to the held sessions of every owner. The
+     * prototype checks run only when a second session is actually being considered.
+     */
+    static boolean admits(int maximumSessions, @NonNull List<Held> held, int requesterUid,
+            @NonNull BooleanSupplier requesterIsPrototypeOwner) {
+        if (held.size() < maximumSessions) {
+            return true;
+        }
+        if (held.size() >= MAXIMUM_PROTOTYPE_OWNER_SESSIONS) {
+            return false;
+        }
+        for (int i = 0; i < held.size(); i++) {
+            if (held.get(i).ownerUid != requesterUid) {
+                return false;
+            }
+        }
+        if (!requesterIsPrototypeOwner.getAsBoolean()) {
+            return false;
+        }
+        for (int i = 0; i < held.size(); i++) {
+            if (!held.get(i).isPrototypeOwner()) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * The same-owner, same-name rule of ComputerControlSessionProcessor#validateRequest (owner package and name),
+     * re-applied at creation so that requests still in flight are covered.
+     */
+    static boolean isNameTaken(@NonNull List<Held> held, @Nullable String ownerPackageName,
+            @Nullable String name) {
+        for (int i = 0; i < held.size(); i++) {
+            if (Objects.equals(ownerPackageName, held.get(i).ownerPackageName)
+                    && Objects.equals(name, held.get(i).name)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * The getOwnedAutomatedDevices "sessionLimit" for one owner uid: the most sessions it can ever hold at once on
+     * this build. MAXIMUM_PROTOTYPE_OWNER_SESSIONS only when the uid is exactly one package and that package passes
+     * the prototype check; a shared or unknown uid gets maximumSessions. It is a capability, never a number of free
+     * slots or a promise of admission: another owner's session, both slots held, a failed close still counted or a
+     * creation in flight still refuse a request.
+     */
+    static int sessionLimit(int maximumSessions, @Nullable String[] ownerPackages,
+            @NonNull Predicate<String> isPrototypeOwner) {
+        if (ownerPackages == null || ownerPackages.length != 1 || ownerPackages[0] == null) {
+            return maximumSessions;
+        }
+        return isPrototypeOwner.test(ownerPackages[0])
+                ? Math.max(maximumSessions, MAXIMUM_PROTOTYPE_OWNER_SESSIONS) : maximumSessions;
+    }
+}
