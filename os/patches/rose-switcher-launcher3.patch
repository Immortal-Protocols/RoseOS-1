diff --git a/quickstep/res/values/rose_agent_strip.xml b/quickstep/res/values/rose_agent_strip.xml
new file mode 100644
index 0000000..ace444b
--- /dev/null
+++ b/quickstep/res/values/rose_agent_strip.xml
@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- RoseOS (#156): the agent row's fixed height in the fallback overview. FallbackActivityInterface claims it below
+     the task cards and OverviewActionsView keeps it free above the action buttons; the layout uses the same value. -->
+<resources>
+    <dimen name="rose_agent_strip_height">200dp</dimen>
+    <!-- RoseOS (#410): the fallback overview's scrim, the Oxblood switcher base (qa/oxblood/oxblood-contract.json
+         fields.screenBase), applied by RecentsActivity after OverviewBlurFallbackStyle. -->
+    <!-- RoseOS (#410): the human task cards' Oxblood identity chip and borders, from Home's contract
+         (qa/oxblood/oxblood-contract.json): the chip is manager.card.fill at 95% (kept nearly opaque so its ivory
+         ink.primary name and chevron stay readable over light app screens; its pressed/hovered overlay is that ink,
+         rose_oxblood_chip_state_fg), and keyboard focus is ink.focusRing.color; hover keeps the stock colour, so focus
+         and hover stay distinct. Used only by the overview's task card layouts (task.xml, icon_app_chip_view.xml). -->
+    <color name="rose_oxblood_chip">#F21A0A0D</color>
+    <color name="rose_oxblood_ink">#FFF2E6D9</color>
+    <color name="rose_oxblood_focus_ring">#FFF2C9B6</color>
+    <style name="RoseOverviewOxblood">
+        <item name="overviewScrimColor">#FF170609</item>
+    </style>
+</resources>
