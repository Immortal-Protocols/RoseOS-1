+package com.android.wm.shell;
+
+import android.app.ActivityManager;
+import android.app.KeyguardManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.ServiceConnection;
+import android.content.pm.PackageManager;
+import android.graphics.BlurMaskFilter;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.PowerManager;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.util.Log;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.view.WindowManager;
+
+import com.android.wm.shell.roseedge.RoseEdgePolicy;
+
+/**
+ * RoseOS (#410, option a): Rose's microphone-input control in the raised edge's slot, drawn by SystemUI.
+ *
+ * <p>Launcher3 leaves a transparent, untouchable hole in its edge window and reports it with
+ * IRoseEdge#setMicSlot. This window covers exactly that hole while the edge is raised. It speaks Rose Agent's existing
+ * tray protocol from SystemUI's existing trusted identity: REGISTER for STATE, then MUTE or UNMUTE on a tap. It never
+ * sends START or END, never starts voice and never touches output, the call or background work. Launcher3 never
+ * reaches the microphone state, and AgentTrayService and its caller check are unchanged: this is one more short-lived
+ * client of the same protocol from the same SystemUI process, through the same AgentTrayLink lifecycle as the tray.
+ * Shown only with the Rose tray enabled, for user 0, unlocked and with the screen on; hidden on every lower.
+ */
+public final class RoseEdgeMicSlot {
+    private static final String TAG = "RoseEdgeMic";
+    private static final String TRAY_PROPERTY = "persist.wm.debug.pixel_agent_tray";
+    private static final String VOICE_PACKAGE = "dev.pixel.voice";
+    private static final int STATE = 100;
+    /** Home's edge (oxblood-contract homeEdge): 92dp tall, its plate a vertical gradient in dp from the edge top. */
+    private static final float EDGE_HEIGHT_DP = 92;
+    private static final float[] PLATE_STOPS_DP = {0, 34, 46, 92};
+    private static final int[] PLATE_COLORS = {0xFF4A141A, 0xFF4A141A, 0xFF3C0E13, 0xFF330C10};
+
+    private final Context mContext;
+    private final WindowManager mWindows;
+    /** Everything runs on the thread that created this (the shell's main thread), including binder callbacks. */
+    private final Handler mHandler = new Handler(Looper.myLooper() != null ? Looper.myLooper() : Looper.getMainLooper());
+    private final RoseEdgePolicy.MicTap mTap = new RoseEdgePolicy.MicTap();
+    private final Runnable mRetryBind;
+    private final AgentTrayLink mLink;
+    private final Messenger mReply;
+    private final ServiceConnection mConnection;
+    private Messenger mVoice;
+    private Control mView;
+    private boolean mKnown;
+    private boolean mMuted;
+    private long mLastCommandAt;
+    /** Where the edge plate starts, in the control's own coordinates (the edge top minus the slot top). */
+    private float mPlateTop;
+
+    public RoseEdgeMicSlot(Context context) {
+        mContext = context.createWindowContext(WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL, null);
+        mWindows = mContext.getSystemService(WindowManager.class);
+        mConnection = new ServiceConnection() {
+            // Delivered on the process's main thread: moved to this control's thread.
+            @Override public void onServiceConnected(ComponentName name, IBinder binder) {
+                mHandler.post(() -> {
+                    mVoice = new Messenger(binder);
+                    mLink.connected();
+                });
+            }
+            @Override public void onServiceDisconnected(ComponentName name) { mHandler.post(mLink::disconnected); }
+            @Override public void onBindingDied(ComponentName name) { mHandler.post(mLink::bindingDied); }
+            @Override public void onNullBinding(ComponentName name) { mHandler.post(mLink::bindingDied); }
+        };
+        mLink = new AgentTrayLink(new AgentTrayLink.Port() {
+            @Override public boolean bind(int user) {
+                try {
+                    return mContext.bindServiceAsUser(new Intent().setComponent(new ComponentName(
+                            VOICE_PACKAGE, "dev.pixel.voice.AgentTrayService")), mConnection,
+                            Context.BIND_AUTO_CREATE, UserHandle.of(user));
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "Voice binding unavailable", e);
+                    return false;
+                }
+            }
+            @Override public void unbind() {
+                try {
+                    mContext.unbindService(mConnection);
+                } catch (IllegalArgumentException e) {
+                    Log.w(TAG, "Voice binding already released", e);
+                }
+            }
+            @Override public boolean send(int what) { return RoseEdgeMicSlot.this.send(what); }
+            @Override public void scheduleRetry() {
+                mHandler.removeCallbacks(mRetryBind);
+                mHandler.postDelayed(mRetryBind, 3000);
+            }
+            @Override public void cancelRetry() { mHandler.removeCallbacks(mRetryBind); }
+            @Override public void resetState() {
+                mKnown = false;
+                mMuted = false;
+                if (mView != null) mView.refresh();
+            }
+            @Override public void forgetService() { mVoice = null; }
+        });
+        mRetryBind = () -> mLink.retry(ActivityManager.getCurrentUser());
+        mReply = new Messenger(new Handler(mHandler.getLooper(), message -> {
+            // Only a fresh v1 STATE from Rose Agent itself, while subscribed, is shown.
+            if (message.what != STATE || !mLink.subscribed() || !trusted(message.sendingUid)) return true;
+            final Bundle data = message.getData();
+            if (data.getInt("protocolVersion") != 1) return true;
+            mKnown = true;
+            mMuted = data.getBoolean("muted");
+            if (mView != null) mView.refresh();
+            return true;
+        }));
+    }
+
+    /**
+     * Covers the slot (screen coordinates) on a display displayHeight tall; hides instead when the tray's gates do
+     * not hold. Launcher3 leaves the slot transparent, so the whole rect is painted with the edge plate behind it.
+     */
+    public void show(Rect slot, int displayHeight) {
+        mPlateTop = displayHeight - dp(EDGE_HEIGHT_DP) - slot.top;
+        if (!allowed()) {
+            hide();
+            return;
+        }
+        final WindowManager.LayoutParams params = new WindowManager.LayoutParams(slot.width(), slot.height(),
+                WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
+                        | WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
+                PixelFormat.TRANSLUCENT);
+        params.gravity = Gravity.TOP | Gravity.LEFT;
+        params.x = slot.left;
+        params.y = slot.top;
+        params.setFitInsetsTypes(0);
+        params.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS;
+        params.setTitle("Rose edge microphone input");
+        if (mView != null) mView.invalidate();
+        if (mView == null) {
+            mView = new Control();
+            mWindows.addView(mView, params);
+        } else {
+            mWindows.updateViewLayout(mView, params);
+        }
+        mLink.screenOn(ActivityManager.getCurrentUser());
+    }
+
+    /** Removes the control and stops its updates; the binding is kept for a quick resume, as the tray does. */
+    public void hide() {
+        mTap.cancel();
+        if (mView != null) {
+            mWindows.removeViewImmediate(mView);
+            mView = null;
+        }
+        mLink.screenOff();
+    }
+
+    private boolean allowed() {
+        final KeyguardManager keyguard = mContext.getSystemService(KeyguardManager.class);
+        final PowerManager power = mContext.getSystemService(PowerManager.class);
+        return SystemProperties.getBoolean(TRAY_PROPERTY, false) && ActivityManager.getCurrentUser() == 0
+                && keyguard != null && !keyguard.isKeyguardLocked() && power != null && power.isInteractive();
+    }
+
+    private boolean trusted(int uid) {
+        try {
+            return mVoice != null && uid == mContext.getPackageManager().getPackageUidAsUser(VOICE_PACKAGE,
+                    mLink.user());
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+
+    private boolean send(int what) {
+        if (mVoice == null) return false;
+        final Message message = Message.obtain(null, what);
+        message.replyTo = mReply;
+        try {
+            mVoice.send(message);
+            return true;
+        } catch (RemoteException e) {
+            return false;
+        }
+    }
+
+    /** A tap mutes or unmutes; nothing happens before the first STATE says which. */
+    private void toggle() {
+        final long now = SystemClock.elapsedRealtime();
+        if (!mKnown || !allowed() || !RoseEdgePolicy.micCommandAllowed(now, mLastCommandAt)) return;
+        mLastCommandAt = now;
+        if (!send(RoseEdgePolicy.micCommand(mMuted))) mLink.disconnected();
+    }
+
+    private int dp(float value) {
+        return Math.round(value * mContext.getResources().getDisplayMetrics().density);
+    }
+
+    /**
+     * The slot's control, drawn exactly as Home's edge draws its microphone well (Rose Agent OxbloodEdge.Well.mic and
+     * OxbloodEdge.MicGlyph; oxblood-contract homeEdge.controls.microphone): over the opaque edge plate, a 32x32dp
+     * plate radius 9 centred in the 44dp slot, and the HiFi microphone on a 24-unit grid at 20dp. Muted: ruby ink,
+     * body at .55, the slash knocked out then drawn, and a 1.4dp ruby ring with a soft glow on the plate. Until the
+     * first STATE the well and glyph are dimmed (a remote state is never guessed); the edge plate stays opaque.
+     */
+    private final class Control extends View {
+        // OxbloodEdge.Well.
+        static final int MIC_PLATE_DP = 32;
+        static final int MIC_RADIUS_DP = 9;
+        static final int FILL_TOP = 0x47140407;
+        static final int FILL_BOTTOM = 0x1f46121c;
+        static final int RING = 0x66eccdbe;
+        static final int TOP_SHADOW = 0x66000000;
+        // OxbloodEdge.MicGlyph.
+        static final int GLYPH_DP = 20;
+        static final int INK = 0xffe6d4c3;
+        static final int MUTED_INK = 0xffff8c9a;
+        static final int MUTED_RING = 0xbfff5a6e;
+        static final int MUTED_GLOW = 0x4dff465f;
+        static final int KNOCKOUT = 0xff1c0609;
+        static final int UNKNOWN_ALPHA = 110;
+
+        private final Paint mPlate = new Paint();
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF mWell = new RectF();
+
+        Control() {
+            super(mContext);
+            setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_YES);
+            setClickable(true);
+            refresh();
+        }
+
+        /** Home's spoken names (HomeTray, RoseConversationActivity): the action a tap takes. */
+        void refresh() {
+            setContentDescription(!mKnown ? "Rose’s microphone, status unavailable"
+                    : mMuted ? "Rose’s microphone is muted. Unmute" : "Mute Rose’s microphone");
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final float d = mContext.getResources().getDisplayMetrics().density;
+            // Opaque edge plate over the whole slot, continuous with Launcher3's edge around it.
+            final float[] positions = new float[PLATE_STOPS_DP.length];
+            for (int i = 0; i < positions.length; i++) positions[i] = PLATE_STOPS_DP[i] / EDGE_HEIGHT_DP;
+            mPlate.setShader(new LinearGradient(0, mPlateTop, 0, mPlateTop + dp(EDGE_HEIGHT_DP), PLATE_COLORS,
+                    positions, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, 0, getWidth(), getHeight(), mPlate);
+            final int layer = mKnown ? -1 : canvas.saveLayerAlpha(0, 0, getWidth(), getHeight(), UNKNOWN_ALPHA);
+            drawWell(canvas, d);
+            drawGlyph(canvas, d, mKnown && mMuted);
+            if (layer >= 0) canvas.restoreToCount(layer);
+        }
+
+        /** OxbloodEdge.Well.draw for Well.mic. */
+        private void drawWell(Canvas c, float d) {
+            final float cx = getWidth() / 2f;
+            final float cy = getHeight() / 2f;
+            final float h = MIC_PLATE_DP * d;
+            final float r = MIC_RADIUS_DP * d;
+            mWell.set(cx - h / 2, cy - h / 2, cx + h / 2, cy + h / 2);
+            mPaint.reset();
+            mPaint.setAntiAlias(true);
+            mPaint.setShader(new LinearGradient(0, mWell.top, 0, mWell.bottom, FILL_TOP, FILL_BOTTOM,
+                    Shader.TileMode.CLAMP));
+            c.drawRoundRect(mWell, r, r, mPaint);
+            mPaint.setShader(null);
+            // inset 0 1px 2px rgba(0,0,0,.4): a soft dark band just inside the top edge.
+            final int save = c.save();
+            final Path clip = new Path();
+            clip.addRoundRect(mWell, r, r, Path.Direction.CW);
+            c.clipPath(clip);
+            mPaint.setStyle(Paint.Style.STROKE);
+            mPaint.setStrokeWidth(2 * d);
+            mPaint.setColor(TOP_SHADOW);
+            mPaint.setMaskFilter(new BlurMaskFilter(Math.max(.1f, (1 * d - .5f) / .57735f),
+                    BlurMaskFilter.Blur.NORMAL));
+            c.drawRoundRect(mWell.left - d, mWell.top - d + d, mWell.right + d, mWell.bottom + 3 * d, r, r, mPaint);
+            mPaint.setMaskFilter(null);
+            c.restoreToCount(save);
+            // inset 0 0 0 1px: the warm ring just inside the edge.
+            final float s = Math.max(1f, d);
+            final float half = s / 2;
+            mPaint.setStrokeWidth(s);
+            mPaint.setColor(RING);
+            c.drawRoundRect(mWell.left + half, mWell.top + half, mWell.right - half, mWell.bottom - half, r - half,
+                    r - half, mPaint);
+        }
+
+        /** OxbloodEdge.MicGlyph.draw. */
+        private void drawGlyph(Canvas c, float d, boolean muted) {
+            final float cx = getWidth() / 2f;
+            final float cy = getHeight() / 2f;
+            if (muted) {
+                final float h = MIC_PLATE_DP * d;
+                final float r = MIC_RADIUS_DP * d;
+                final float w = 1.4f * d;
+                final RectF plate = new RectF(cx - h / 2 + w / 2, cy - h / 2 + w / 2, cx + h / 2 - w / 2,
+                        cy + h / 2 - w / 2);
+                mPaint.reset();
+                mPaint.setAntiAlias(true);
+                mPaint.setStyle(Paint.Style.STROKE);
+                mPaint.setStrokeWidth(4 * d);
+                mPaint.setColor(MUTED_GLOW);
+                mPaint.setMaskFilter(new BlurMaskFilter(5 * d, BlurMaskFilter.Blur.NORMAL));
+                c.drawRoundRect(plate, r, r, mPaint);
+                mPaint.setMaskFilter(null);
+                mPaint.setStrokeWidth(w);
+                mPaint.setColor(MUTED_RING);
+                c.drawRoundRect(plate, r - w / 2, r - w / 2, mPaint);
+            }
+            final int save = c.save();
+            final float s = GLYPH_DP * d / 24f;
+            c.translate(cx - 12 * s, cy - 12 * s);
+            c.scale(s, s);
+            final int ink = muted ? MUTED_INK : INK;
+            final int body = muted ? (ink & 0x00ffffff) | (Math.round(.55f * 255) << 24) : ink;
+            mPaint.reset();
+            mPaint.setAntiAlias(true);
+            mPaint.setColor(body);
+            c.drawRoundRect(new RectF(8.6f, 2.5f, 15.4f, 15f), 3.4f, 3.4f, mPaint);
+            mPaint.setStyle(Paint.Style.STROKE);
+            mPaint.setStrokeWidth(1.9f);
+            mPaint.setStrokeCap(Paint.Cap.ROUND);
+            c.drawArc(new RectF(5.6f, 4.4f, 18.4f, 17.2f), 0, 180, false, mPaint);
+            c.drawLine(12, 17.4f, 12, 20.6f, mPaint);
+            c.drawLine(8.8f, 20.8f, 15.2f, 20.8f, mPaint);
+            if (muted) {
+                // The slash, knocked out of the well (the well's own dark) and then drawn.
+                mPaint.setStrokeWidth(3.4f);
+                mPaint.setColor(KNOCKOUT);
+                c.drawLine(4.5f, 3.5f, 19.5f, 20.5f, mPaint);
+                mPaint.setStrokeWidth(1.9f);
+                mPaint.setColor(ink);
+                c.drawLine(4.5f, 3.5f, 19.5f, 20.5f, mPaint);
+            }
+            c.restoreToCount(save);
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            final float slop = ViewConfiguration.get(mContext).getScaledTouchSlop();
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    mTap.down(event.getX(), event.getY(), event.getEventTime());
+                    return true;
+                case MotionEvent.ACTION_MOVE:
+                    mTap.move(event.getX(), event.getY(), slop);
+                    return true;
+                case MotionEvent.ACTION_UP:
+                    final boolean inside = event.getX() >= 0 && event.getY() >= 0 && event.getX() <= getWidth()
+                            && event.getY() <= getHeight();
+                    if (mTap.up(event.getX(), event.getY(), event.getEventTime(), slop, inside)) performClick();
+                    return true;
+                default:
+                    mTap.cancel();
+                    return true;
+            }
+        }
+
+        @Override
+        public boolean performClick() {
+            super.performClick();
+            toggle();
+            return true;
+        }
+    }
+}
