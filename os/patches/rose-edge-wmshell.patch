+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.wm.shell.roseedge;
+
+import com.android.wm.shell.roseedge.IRoseEdgeListener;
+
+/**
+ * RoseOS (#410): the Rose raised edge, exported by the shell to the bound recents component (Launcher3) through
+ * ShellController's external interfaces. Every call requires MANAGE_ACTIVITY_TASKS. Contract agreed on #410.
+ */
+interface IRoseEdge {
+
+    /**
+     * Shrinks the default task display area so the focused fullscreen app taskId on displayId gets the bounds
+     * (0, 0, W, H - liftPx): width unchanged, nothing scaled. Answers on listener with onRaised or onRefused.
+     */
+    oneway void raise(int displayId, int taskId, int liftPx, IRoseEdgeListener listener) = 1;
+
+    /** Restores full height. Answers onLowered(displayId, 0) on the raising listener when something was raised. */
+    oneway void lower(int displayId) = 2;
+}
diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/roseedge/IRoseEdgeListener.aidl b/libs/WindowManager/Shell/src/com/android/wm/shell/roseedge/IRoseEdgeListener.aidl
