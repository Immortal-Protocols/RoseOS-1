+
+package com.android.wm.shell.roseedge;
+
+/**
+ * RoseOS (#410): the rules of the Rose raised edge, free of Android state so that they can be tested on their own.
+ *
+ * <p>Launcher3 (the bound recents component) asks the shell to raise the edge over the foreground app. The shell then
+ * shrinks the default task display area to {@code (0, 0, W, H - liftPx)}: the fullscreen app gets real, smaller
+ * bounds with its width unchanged, and relayouts. Nothing is scaled. Lowering clears the bounds. This class decides
+ * whether a raise is allowed and when a raised edge must come down; {@link RoseEdgeController} applies it.
+ *
+ * <p>The reason values are the {@code IRoseEdgeListener} contract agreed with OS Product on #410.
+ */
+public final class RoseEdgePolicy {
+    // IRoseEdgeListener.onRefused reasons.
+    public static final int REFUSED_NOT_TOP_TASK = 1;
+    public static final int REFUSED_NOT_RESIZEABLE = 2;
+    public static final int REFUSED_LOCKED = 3;
+    public static final int REFUSED_ROTATION = 4;
+    public static final int REFUSED_MULTI_WINDOW = 5;
+    /** Another caller's edge is raised, a raise or lower is still in flight, or the IME is showing. */
+    public static final int REFUSED_BUSY = 6;
+    public static final int REFUSED_LIFT = 7;
+    public static final int REFUSED_DISABLED = 8;
+    public static final int REFUSED_DISPLAY = 9;
+
+    // IRoseEdgeListener.onLowered reasons.
+    public static final int LOWERED_REQUESTED = 0;
+    public static final int LOWERED_TASK = 1;
+    public static final int LOWERED_HOME = 2;
+    public static final int LOWERED_KEYGUARD = 3;
+    public static final int LOWERED_DISPLAY = 4;
+    public static final int LOWERED_IME = 5;
+    public static final int LOWERED_CALLER_DIED = 6;
+    public static final int LOWERED_USER = 7;
+
+    /** No lowering needed. */
+    public static final int KEEP = -1;
+
+    /** The largest lift, in dp, before the quarter-height cap. */
+    public static final int MAX_LIFT_DP = 160;
+    public static final int DEFAULT_DISPLAY = 0;
+    public static final int ROTATION_0 = 0;
+
+    /** What the shell knows about one task when it decides. */
+    public static final class TaskState {
+        public final int taskId;
+        public final int displayId;
+        public final boolean visible;
+        public final boolean fullscreen;
+        /** An ordinary app task, not Home, recents, assistant or dream. */
+        public final boolean standard;
+        public final boolean resizeable;
+        public final boolean sizeCompat;
+
+        public TaskState(int taskId, int displayId, boolean visible, boolean fullscreen, boolean standard,
+                boolean resizeable, boolean sizeCompat) {
+            this.taskId = taskId;
+            this.displayId = displayId;
+            this.visible = visible;
+            this.fullscreen = fullscreen;
+            this.standard = standard;
+            this.resizeable = resizeable;
+            this.sizeCompat = sizeCompat;
+        }
+    }
+
+    /** The display and shell conditions a raise is judged against. */
+    public static final class Conditions {
+        public final boolean enabled;
+        public final int displayHeight;
+        public final float density;
+        public final int rotation;
+        public final boolean keyguardVisible;
+        public final boolean imeVisible;
+        /** A split, PiP, freeform or other multi-window task is visible on the display. */
+        public final boolean multiWindowVisible;
+
+        public Conditions(boolean enabled, int displayHeight, float density, int rotation, boolean keyguardVisible,
+                boolean imeVisible, boolean multiWindowVisible) {
+            this.enabled = enabled;
+            this.displayHeight = displayHeight;
+            this.density = density;
+            this.rotation = rotation;
+            this.keyguardVisible = keyguardVisible;
+            this.imeVisible = imeVisible;
+            this.multiWindowVisible = multiWindowVisible;
+        }
+    }
+
+    private RoseEdgePolicy() {}
+
+    /** The largest lift allowed: a quarter of the display height, and never more than MAX_LIFT_DP. */
+    public static int maxLiftPx(int displayHeight, float density) {
+        return Math.min(displayHeight / 4, Math.round(MAX_LIFT_DP * density));
+    }
+
+    /**
+     * 0 when the edge may be raised over {@code taskId}, else the refusal reason. {@code top} is the focused task on
+     * the display, or null; {@code busy} means a raise or lower is in flight, or another caller's edge is raised.
+     */
+    public static int refusal(int displayId, int taskId, int liftPx, Conditions c, TaskState top, boolean busy) {
+        if (!c.enabled) return REFUSED_DISABLED;
+        if (displayId != DEFAULT_DISPLAY) return REFUSED_DISPLAY;
+        if (liftPx <= 0 || liftPx > maxLiftPx(c.displayHeight, c.density)) return REFUSED_LIFT;
+        if (c.keyguardVisible) return REFUSED_LOCKED;
+        if (busy || c.imeVisible) return REFUSED_BUSY;
+        if (c.rotation != ROTATION_0) return REFUSED_ROTATION;
+        if (c.multiWindowVisible) return REFUSED_MULTI_WINDOW;
+        if (top == null || top.taskId != taskId || top.displayId != displayId || !top.visible || !top.fullscreen
+                || !top.standard) {
+            return REFUSED_NOT_TOP_TASK;
+        }
+        if (!top.resizeable || top.sizeCompat) return REFUSED_NOT_RESIZEABLE;
+        return 0;
+    }
+
+    // The edge's microphone-input slot (#410 option a): SystemUI's existing trusted tray protocol, mute only.
+    /** AgentTrayService's MUTE and UNMUTE; the slot never sends START (3) or END (6). */
+    public static final int MIC_MUTE = 4;
+    public static final int MIC_UNMUTE = 5;
+    public static final int MIC_SLOT_MIN_DP = 32;
+    public static final int MIC_SLOT_MAX_DP = 64;
+    public static final long MIC_TAP_MAX_MS = 400;
+    /** The tray's own spacing between commands. */
+    public static final long MIC_COMMAND_SPACING_MS = 600;
+
+    /**
+     * Whether Launcher3's slot may carry the trusted mute control: inside the raised display's bottom band
+     * (0, H - maxLiftPx, W, H), and 32-64dp on each side. Anything else is ignored, so the control can never be
+     * placed elsewhere on screen.
+     */
+    public static boolean validMicSlot(int left, int top, int right, int bottom, int displayWidth, int displayHeight,
+            float density) {
+        final int width = right - left;
+        final int height = bottom - top;
+        final int min = Math.round(MIC_SLOT_MIN_DP * density);
+        final int max = Math.round(MIC_SLOT_MAX_DP * density);
+        return left >= 0 && right <= displayWidth && bottom <= displayHeight
+                && top >= displayHeight - maxLiftPx(displayHeight, density)
+                && width >= min && width <= max && height >= min && height <= max;
+    }
+
+    /** The only command a tap sends: it mutes or unmutes Rose's microphone input, never starts or ends anything. */
+    public static int micCommand(boolean muted) {
+        return muted ? MIC_UNMUTE : MIC_MUTE;
+    }
+
+    /** Commands are spaced like the tray's; lastCommandAt 0 means none yet. */
+    public static boolean micCommandAllowed(long now, long lastCommandAt) {
+        return lastCommandAt == 0 || now - lastCommandAt >= MIC_COMMAND_SPACING_MS;
+    }
+
+    /** A single short tap that stays within slop and ends inside the control. */
+    public static final class MicTap {
+        private boolean mDown;
+        private float mX;
+        private float mY;
+        private long mAt;
+
+        public void down(float x, float y, long at) {
+            mDown = true;
+            mX = x;
+            mY = y;
+            mAt = at;
+        }
+
+        public void move(float x, float y, float slop) {
+            if (Math.abs(x - mX) > slop || Math.abs(y - mY) > slop) mDown = false;
+        }
+
+        public void cancel() {
+            mDown = false;
+        }
+
+        public boolean up(float x, float y, long at, float slop, boolean inside) {
+            final boolean tap = mDown && inside && Math.abs(x - mX) <= slop && Math.abs(y - mY) <= slop
+                    && at - mAt <= MIC_TAP_MAX_MS;
+            mDown = false;
+            return tap;
+        }
+    }
+
+    /** The task display area's bounds while raised: full width, the bottom moved up by liftPx. */
+    public static int[] raisedBounds(int displayWidth, int displayHeight, int liftPx) {
+        return new int[] {0, 0, displayWidth, displayHeight - liftPx};
+    }
+
+    /** The one raised edge, owned by the listener binder that raised it. */
+    public static final class State {
+        private Object mOwner;
+        private int mDisplayId = -1;
+        private int mTaskId = -1;
+        private int mLiftPx;
+        private boolean mInFlight;
+        private int[] mMicSlot;
+
+        public boolean raised() {
+            return mOwner != null;
+        }
+
+        public Object owner() {
+            return mOwner;
+        }
+
+        public int displayId() {
+            return mDisplayId;
+        }
+
+        public int taskId() {
+            return mTaskId;
+        }
+
+        public int liftPx() {
+            return mLiftPx;
+        }
+
+        /** A slot belongs to the current raise on its display; it is dropped by every lower (clear). */
+        public boolean acceptsMicSlot(int displayId) {
+            return raised() && displayId == mDisplayId;
+        }
+
+        /** The slot's {left, top, right, bottom}, or null to clear it. */
+        public void setMicSlot(int[] slot) {
+            mMicSlot = slot;
+        }
+
+        public int[] micSlot() {
+            return mMicSlot;
+        }
+
+        /** A raise or lower has been sent and its transition has not finished. */
+        public boolean inFlight() {
+            return mInFlight;
+        }
+
+        public void setInFlight(boolean inFlight) {
+            mInFlight = inFlight;
+        }
+
+        /** Whether a raise by {@code owner} must wait: anything in flight, or another owner's edge is raised. */
+        public boolean busyFor(Object owner) {
+            return mInFlight || (mOwner != null && mOwner != owner);
+        }
+
+        public void raise(Object owner, int displayId, int taskId, int liftPx) {
+            mOwner = owner;
+            mDisplayId = displayId;
+            mTaskId = taskId;
+            mLiftPx = liftPx;
+        }
+
+        /** Forgets the raise and returns its owner, or null if nothing was raised. */
+        public Object clear() {
+            final Object owner = mOwner;
+            mOwner = null;
+            mDisplayId = -1;
+            mTaskId = -1;
+            mLiftPx = 0;
+            mMicSlot = null;
+            return owner;
+        }
+
+        /** The focused task changed. Home or recents in front lowers with LOWERED_HOME, any other task with TASK. */
+        public int onFocusChanged(TaskState focused, boolean homeOrRecents) {
+            if (!raised() || focused == null || focused.displayId != mDisplayId) return KEEP;
+            if (homeOrRecents) return LOWERED_HOME;
+            return focused.taskId == mTaskId ? KEEP : LOWERED_TASK;
+        }
+
+        /** The raised task stopped being a visible, resizeable fullscreen app (its own new bounds change nothing). */
+        public int onTaskInfoChanged(TaskState task) {
+            if (!raised() || task == null || task.taskId != mTaskId) return KEEP;
+            return task.visible && task.fullscreen && task.standard && task.resizeable && !task.sizeCompat
+                    ? KEEP : LOWERED_TASK;
+        }
+
+        public int onTaskVanished(int taskId) {
+            return raised() && taskId == mTaskId ? LOWERED_TASK : KEEP;
+        }
+
+        /** Any keyguard, occluded or not, lowers. */
+        public int onKeyguard(boolean visible) {
+            return raised() && visible ? LOWERED_KEYGUARD : KEEP;
+        }
+
+        /** Any configuration change of the raised display (rotation, size, density) or its removal lowers. */
+        public int onDisplayChanged(int displayId) {
+            return raised() && displayId == mDisplayId ? LOWERED_DISPLAY : KEEP;
+        }
+
+        public int onImeVisibility(int displayId, boolean showing) {
+            return raised() && showing && displayId == mDisplayId ? LOWERED_IME : KEEP;
+        }
+
+        public int onUserChanged() {
+            return raised() ? LOWERED_USER : KEEP;
+        }
+
+        /** The listener that raised the edge died, or its binder interface was invalidated. */
+        public int onOwnerGone(Object owner) {
+            return raised() && owner == mOwner ? LOWERED_CALLER_DIED : KEEP;
+        }
+
+        /** An explicit lower; lowering is always safe, so any permitted caller may ask. */
+        public int onLowerRequested(int displayId) {
+            return raised() && displayId == mDisplayId ? LOWERED_REQUESTED : KEEP;
+        }
+    }
+}
