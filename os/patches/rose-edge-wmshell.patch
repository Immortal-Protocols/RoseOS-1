@@ -0,0 +1,24 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.wm.shell.roseedge;
+
+import android.graphics.Rect;
+
+/**
+ * RoseOS (#410): answers from the shell's Rose raised edge, implemented by Launcher3. Reason values are
+ * RoseEdgePolicy's REFUSED_* and LOWERED_* constants.
+ */
+oneway interface IRoseEdgeListener {
+
+    /** The edge is raised over taskId; appBounds are the task's actual bounds. */
+    void onRaised(int displayId, int taskId, in Rect appBounds) = 1;
+
+    /** The raise was refused and nothing changed. */
+    void onRefused(int displayId, int taskId, int reason) = 2;
+
+    /** The edge came down and the app has full height again. */
+    void onLowered(int displayId, int reason) = 3;
+}
diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/roseedge/RoseEdgeController.java b/libs/WindowManager/Shell/src/com/android/wm/shell/roseedge/RoseEdgeController.java
new file mode 100644
index 0000000..7b09c2d
--- /dev/null
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/roseedge/RoseEdgeController.java
@@ -0,0 +1,482 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.wm.shell.roseedge;
+
+import static android.app.WindowConfiguration.ACTIVITY_TYPE_HOME;
+import static android.app.WindowConfiguration.ACTIVITY_TYPE_RECENTS;
+import static android.app.WindowConfiguration.ACTIVITY_TYPE_STANDARD;
+import static android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN;
+import static android.app.WindowConfiguration.WINDOWING_MODE_UNDEFINED;
+import static android.view.WindowManager.TRANSIT_CHANGE;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.ActivityManager.RunningTaskInfo;
+import android.app.KeyguardManager;
+import android.content.Context;
+import android.content.res.Configuration;
+import android.graphics.Rect;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.SystemProperties;
+import android.util.ArrayMap;
+import android.util.Slog;
+import android.view.Display;
+import android.view.SurfaceControl;
+import android.window.DisplayAreaInfo;
+import android.window.TransitionInfo;
+import android.window.TransitionRequestInfo;
+import android.window.WindowContainerTransaction;
+
+import com.android.wm.shell.RootTaskDisplayAreaOrganizer;
+import com.android.wm.shell.ShellTaskOrganizer;
+import com.android.wm.shell.common.DisplayController;
+import com.android.wm.shell.common.DisplayImeController;
+import com.android.wm.shell.common.DisplayLayout;
+import com.android.wm.shell.common.ExternalInterfaceBinder;
+import com.android.wm.shell.common.RemoteCallable;
+import com.android.wm.shell.common.ShellExecutor;
+import com.android.wm.shell.sysui.KeyguardChangeListener;
+import com.android.wm.shell.sysui.ShellController;
+import com.android.wm.shell.sysui.ShellInit;
+import com.android.wm.shell.sysui.UserChangeListener;
+import com.android.wm.shell.transition.Transitions;
+
+/**
+ * RoseOS (#410): the shell side of the Rose raised edge (resize on release).
+ *
+ * <p>Launcher3 owns the gesture and the edge window. When a short swipe is released over an app it calls
+ * {@link IRoseEdge#raise}; the shell shrinks the default task display area (which only the shell organizes) to
+ * {@code (0, 0, W, H - liftPx)} in one TRANSIT_CHANGE transition. The fullscreen app fills its parent, so it gets real
+ * smaller bounds with its width unchanged, a configuration change and a full relayout: its own bottom bar or composer
+ * moves up. Nothing is scaled, cropped into a preview or padded. {@link IRoseEdge#lower} clears the bounds.
+ *
+ * <p>Every rule is in {@link RoseEdgePolicy}. Default off ({@value #ENABLED_PROPERTY}). The interface reaches only
+ * the bound recents component and requires MANAGE_ACTIVITY_TASKS, which the shell checks on every call; no permission
+ * or caller trust is added. The edge is owned by the listener that raised it and comes down on its own when that task
+ * leaves the front, Home or recents opens, the keyguard shows, the display changes, the IME shows, the user switches or
+ * the owner dies.
+ */
+public class RoseEdgeController implements RemoteCallable<RoseEdgeController>, Transitions.TransitionHandler,
+        ShellTaskOrganizer.FocusListener, ShellTaskOrganizer.TaskInfoChangedListener,
+        ShellTaskOrganizer.TaskVanishedListener, KeyguardChangeListener, UserChangeListener,
+        DisplayController.OnDisplaysChangedListener, DisplayImeController.ImePositionProcessor,
+        RootTaskDisplayAreaOrganizer.RootTaskDisplayAreaListener {
+    private static final String TAG = "RoseEdge";
+    static final String ENABLED_PROPERTY = "persist.wm.debug.rose_edge";
+
+    private final Context mContext;
+    private final ShellController mShellController;
+    private final ShellTaskOrganizer mTaskOrganizer;
+    private final RootTaskDisplayAreaOrganizer mRootTdaOrganizer;
+    private final DisplayController mDisplayController;
+    private final DisplayImeController mImeController;
+    private final Transitions mTransitions;
+    private final ShellExecutor mMainExecutor;
+
+    private final RoseEdgePolicy.State mState = new RoseEdgePolicy.State();
+    /** This controller's own transitions, and what to report when each one has been applied. */
+    private final ArrayMap<IBinder, Applied> mOwnTransitions = new ArrayMap<>();
+    @Nullable private IRoseEdgeListener mListener;
+    @Nullable private IBinder.DeathRecipient mListenerDeath;
+    @Nullable private RunningTaskInfo mFocused;
+    private boolean mKeyguardVisible;
+    private boolean mImeVisible;
+
+    /** What one of this controller's transitions does. */
+    private static final class Applied {
+        final boolean mRaise;
+        final int mDisplayId;
+        final int mTaskId;
+        final int mReason;
+        @Nullable final IRoseEdgeListener mListener;
+        @Nullable final Rect mBounds;
+        @Nullable final WindowContainerTransaction mWct;
+
+        Applied(boolean raise, int displayId, int taskId, int reason, @Nullable IRoseEdgeListener listener,
+                @Nullable Rect bounds, @Nullable WindowContainerTransaction wct) {
+            mRaise = raise;
+            mDisplayId = displayId;
+            mTaskId = taskId;
+            mReason = reason;
+            mListener = listener;
+            mBounds = bounds;
+            mWct = wct;
+        }
+    }
+
+    public RoseEdgeController(@NonNull Context context, @NonNull ShellInit shellInit,
+            @NonNull ShellController shellController, @NonNull ShellTaskOrganizer taskOrganizer,
+            @NonNull RootTaskDisplayAreaOrganizer rootTdaOrganizer, @NonNull DisplayController displayController,
+            @NonNull DisplayImeController imeController, @NonNull Transitions transitions,
+            @NonNull ShellExecutor mainExecutor) {
+        mContext = context;
+        mShellController = shellController;
+        mTaskOrganizer = taskOrganizer;
+        mRootTdaOrganizer = rootTdaOrganizer;
+        mDisplayController = displayController;
+        mImeController = imeController;
+        mTransitions = transitions;
+        mMainExecutor = mainExecutor;
+        shellInit.addInitCallback(this::onInit, this);
+    }
+
+    private void onInit() {
+        mShellController.addExternalInterface(IRoseEdge.DESCRIPTOR, this::createExternalInterface, this);
+        mShellController.addKeyguardChangeListener(this);
+        mShellController.addUserChangeListener(this);
+        mTaskOrganizer.addFocusListener(this);
+        mTaskOrganizer.addTaskInfoChangedListener(this);
+        mTaskOrganizer.addTaskVanishedListener(this);
+        mDisplayController.addDisplayWindowListener(this);
+        mImeController.addPositionProcessor(this);
+        mTransitions.addHandler(this);
+        mRootTdaOrganizer.registerListener(Display.DEFAULT_DISPLAY, this);
+    }
+
+    private static boolean enabled() {
+        return SystemProperties.getBoolean(ENABLED_PROPERTY, false);
+    }
+
+    // Remote calls, on the main executor after the MANAGE_ACTIVITY_TASKS check.
+
+    private void raise(int displayId, int taskId, int liftPx, @Nullable IRoseEdgeListener listener) {
+        if (listener == null) return;
+        final IBinder owner = listener.asBinder();
+        final DisplayLayout layout = mDisplayController.getDisplayLayout(displayId);
+        final DisplayAreaInfo tda = mRootTdaOrganizer.getDisplayAreaInfo(displayId);
+        final int reason = layout == null || tda == null ? RoseEdgePolicy.REFUSED_DISPLAY
+                : RoseEdgePolicy.refusal(displayId, taskId, liftPx, conditions(displayId, layout),
+                        taskState(mFocused), mState.busyFor(owner));
+        if (reason != 0) {
+            refused(listener, displayId, taskId, reason);
+            return;
+        }
+        if (!linkOwner(listener)) return;
+        mState.raise(owner, displayId, taskId, liftPx);
+        final int[] b = RoseEdgePolicy.raisedBounds(layout.width(), layout.height(), liftPx);
+        final Rect bounds = new Rect(b[0], b[1], b[2], b[3]);
+        final WindowContainerTransaction wct = new WindowContainerTransaction();
+        wct.setBounds(tda.token, bounds);
+        start(wct, new Applied(true, displayId, taskId, 0, listener, bounds, null));
+    }
+
+    private void requestLower(int displayId) {
+        lowerIfNeeded(mState.onLowerRequested(displayId));
+    }
+
+    private void onInterfaceInvalidated() {
+        // Launcher3's connection was reset (its binder interfaces were re-created): the edge it raised comes down.
+        if (mState.raised()) lowerNow(RoseEdgePolicy.LOWERED_CALLER_DIED);
+    }
+
+    // Raising and lowering.
+
+    private void lowerIfNeeded(int reason) {
+        if (reason != RoseEdgePolicy.KEEP) lowerNow(reason);
+    }
+
+    private void lowerNow(int reason) {
+        if (!mState.raised()) return;
+        final int displayId = mState.displayId();
+        final IRoseEdgeListener listener = mListener;
+        mState.clear();
+        unlinkOwner();
+        final DisplayAreaInfo tda = mRootTdaOrganizer.getDisplayAreaInfo(displayId);
+        if (tda == null) {
+            // The display area is gone with its display; nothing is left to restore.
+            lowered(listener, displayId, reason);
+            return;
+        }
+        final WindowContainerTransaction wct = new WindowContainerTransaction();
+        wct.setBounds(tda.token, new Rect());  // empty: fill the display again
+        start(wct, new Applied(false, displayId, -1, reason, listener, null, wct));
+    }
+
+    private void start(@NonNull WindowContainerTransaction wct, @NonNull Applied applied) {
+        mState.setInFlight(true);
+        mOwnTransitions.put(mTransitions.startTransition(TRANSIT_CHANGE, wct, this), applied);
+    }
+
+    /** One of this controller's transitions was applied (played or merged). */
+    private void onApplied(@NonNull Applied applied, @Nullable TransitionInfo info) {
+        mState.setInFlight(!mOwnTransitions.isEmpty());
+        if (!applied.mRaise) {
+            lowered(applied.mListener, applied.mDisplayId, applied.mReason);
+            return;
+        }
+        // Lowered (or replaced) before the raise played: its own lower reports.
+        if (!mState.raised() || mState.owner() != ownerOf(applied.mListener)
+                || mState.taskId() != applied.mTaskId) {
+            return;
+        }
+        final Rect appBounds = new Rect(applied.mBounds);
+        if (info != null) {
+            for (TransitionInfo.Change change : info.getChanges()) {
+                final RunningTaskInfo task = change.getTaskInfo();
+                if (task != null && task.taskId == applied.mTaskId) {
+                    appBounds.set(change.getEndAbsBounds());
+                }
+            }
+        }
+        try {
+            applied.mListener.onRaised(applied.mDisplayId, applied.mTaskId, appBounds);
+        } catch (RemoteException e) {
+            Slog.w(TAG, "onRaised not delivered", e);
+        }
+    }
+
+    /** One of this controller's transitions was aborted: none of its changes were applied. */
+    private void onAborted(@NonNull Applied applied) {
+        mState.setInFlight(!mOwnTransitions.isEmpty());
+        if (applied.mRaise) {
+            if (mState.raised() && mState.owner() == ownerOf(applied.mListener)
+                    && mState.taskId() == applied.mTaskId) {
+                mState.clear();
+                unlinkOwner();
+            }
+            refused(applied.mListener, applied.mDisplayId, applied.mTaskId, RoseEdgePolicy.REFUSED_BUSY);
+            return;
+        }
+        // A lower must never be lost, or the app would stay short: apply it directly.
+        mRootTdaOrganizer.applyTransaction(applied.mWct);
+        lowered(applied.mListener, applied.mDisplayId, applied.mReason);
+    }
+
+    // Transitions.TransitionHandler: only this controller's own transitions, played without animation.
+
+    @Override
+    public boolean startAnimation(@NonNull IBinder transition, @NonNull TransitionInfo info,
+            @NonNull SurfaceControl.Transaction startTransaction,
+            @NonNull SurfaceControl.Transaction finishTransaction,
+            @NonNull Transitions.TransitionFinishCallback finishCallback) {
+        final Applied applied = mOwnTransitions.remove(transition);
+        if (applied == null) return false;
+        // No scale and no screenshot: the app appears at its new size once it has drawn at that size.
+        startTransaction.apply();
+        finishCallback.onTransitionFinished(null);
+        onApplied(applied, info);
+        return true;
+    }
+
+    @Nullable
+    @Override
+    public Transitions.RequestResult handleRequestOnly(@NonNull IBinder transition,
+            @NonNull TransitionRequestInfo request) {
+        return null;
+    }
+
+    @Override
+    public void onTransitionConsumed(@NonNull IBinder transition, boolean aborted,
+            @Nullable SurfaceControl.Transaction finishTransaction) {
+        final Applied applied = mOwnTransitions.remove(transition);
+        if (applied == null) return;
+        if (aborted) {
+            onAborted(applied);
+        } else {
+            onApplied(applied, null);  // merged into another transition: its changes were applied
+        }
+    }
+
+    // Events that lower the edge. ShellTaskOrganizer calls its listeners holding its own lock, so their work is
+    // posted: no transition is ever started inside that lock.
+
+    @Override
+    public void onFocusTaskChanged(RunningTaskInfo taskInfo) {
+        mMainExecutor.execute(() -> {
+            mFocused = taskInfo;
+            final int type = taskInfo == null ? -1 : taskInfo.getActivityType();
+            lowerIfNeeded(mState.onFocusChanged(taskState(taskInfo),
+                    type == ACTIVITY_TYPE_HOME || type == ACTIVITY_TYPE_RECENTS));
+        });
+    }
+
+    @Override
+    public void onTaskInfoChanged(RunningTaskInfo taskInfo) {
+        mMainExecutor.execute(() -> {
+            if (mFocused != null && taskInfo.taskId == mFocused.taskId) mFocused = taskInfo;
+            lowerIfNeeded(mState.onTaskInfoChanged(taskState(taskInfo)));
+        });
+    }
+
+    @Override
+    public void onTaskVanished(RunningTaskInfo taskInfo) {
+        mMainExecutor.execute(() -> {
+            if (mFocused != null && taskInfo.taskId == mFocused.taskId) mFocused = null;
+            lowerIfNeeded(mState.onTaskVanished(taskInfo.taskId));
+        });
+    }
+
+    @Override
+    public void onKeyguardVisibilityChanged(boolean visible, boolean occluded, boolean animatingDismiss) {
+        mKeyguardVisible = visible;
+        lowerIfNeeded(mState.onKeyguard(visible));
+    }
+
+    @Override
+    public void onUserChanged(int newUserId, @NonNull Context userContext) {
+        lowerIfNeeded(mState.onUserChanged());
+    }
+
+    @Override
+    public void onDisplayConfigurationChanged(int displayId, Configuration newConfig,
+            @Nullable DisplayLayout oldLayout) {
+        // Only a change of the display's geometry (rotation, size or density) invalidates the raised bounds.
+        final DisplayLayout layout = mDisplayController.getDisplayLayout(displayId);
+        if (oldLayout != null && layout != null && oldLayout.width() == layout.width()
+                && oldLayout.height() == layout.height() && oldLayout.rotation() == layout.rotation()
+                && oldLayout.densityDpi() == layout.densityDpi()) {
+            return;
+        }
+        lowerIfNeeded(mState.onDisplayChanged(displayId));
+    }
+
+    @Override
+    public void onDisplayRemoved(int displayId) {
+        lowerIfNeeded(mState.onDisplayChanged(displayId));
+    }
+
+    @Override
+    public void onImeVisibilityChanged(int displayId, boolean isShowing) {
+        if (displayId == Display.DEFAULT_DISPLAY) mImeVisible = isShowing;
+        lowerIfNeeded(mState.onImeVisibility(displayId, isShowing));
+    }
+
+    @Override
+    public void onDisplayAreaAppeared(DisplayAreaInfo displayAreaInfo) {
+        // The shell (re)started: a raise from a shell that died would otherwise keep the app short, because the
+        // server keeps a dead organizer's requested bounds. Clearing already-full bounds changes nothing.
+        if (mState.raised() || !enabled()) return;
+        final WindowContainerTransaction wct = new WindowContainerTransaction();
+        wct.setBounds(displayAreaInfo.token, new Rect());
+        mRootTdaOrganizer.applyTransaction(wct);
+    }
+
+    // Helpers.
+
+    private RoseEdgePolicy.Conditions conditions(int displayId, @NonNull DisplayLayout layout) {
+        return new RoseEdgePolicy.Conditions(enabled(), layout.height(), layout.density(), layout.rotation(),
+                mKeyguardVisible || keyguardLocked(), mImeVisible, multiWindowVisible(displayId));
+    }
+
+    /** Read live as well, so a raise is refused while locked even before the shell's first keyguard callback. */
+    private boolean keyguardLocked() {
+        final KeyguardManager keyguard = mContext.getSystemService(KeyguardManager.class);
+        return keyguard == null || keyguard.isKeyguardLocked();
+    }
+
+    private boolean multiWindowVisible(int displayId) {
+        for (RunningTaskInfo task : mTaskOrganizer.getRunningTasks(displayId)) {
+            if (!task.isVisible) continue;
+            final int mode = task.getWindowingMode();
+            if (mode != WINDOWING_MODE_FULLSCREEN && mode != WINDOWING_MODE_UNDEFINED) return true;
+        }
+        return false;
+    }
+
+    @Nullable
+    private static RoseEdgePolicy.TaskState taskState(@Nullable RunningTaskInfo task) {
+        if (task == null) return null;
+        return new RoseEdgePolicy.TaskState(task.taskId, task.displayId, task.isVisible,
+                task.getWindowingMode() == WINDOWING_MODE_FULLSCREEN,
+                task.getActivityType() == ACTIVITY_TYPE_STANDARD, task.isResizeable,
+                task.appCompatTaskInfo != null && task.appCompatTaskInfo.isTopActivityInSizeCompat());
+    }
+
+    @Nullable
+    private static IBinder ownerOf(@Nullable IRoseEdgeListener listener) {
+        return listener == null ? null : listener.asBinder();
+    }
+
+    /** Ties the edge to the listener's process; false (and nothing raised) if it is already dead. */
+    private boolean linkOwner(@NonNull IRoseEdgeListener listener) {
+        final IBinder binder = listener.asBinder();
+        if (mListener != null && mListener.asBinder() == binder) return true;
+        unlinkOwner();
+        final IBinder.DeathRecipient death = () -> mMainExecutor.execute(
+                () -> lowerIfNeeded(mState.onOwnerGone(binder)));
+        try {
+            binder.linkToDeath(death, 0);
+        } catch (RemoteException e) {
+            return false;
+        }
+        mListener = listener;
+        mListenerDeath = death;
+        return true;
+    }
+
+    private void unlinkOwner() {
+        if (mListener != null && mListenerDeath != null) {
+            mListener.asBinder().unlinkToDeath(mListenerDeath, 0);
+        }
+        mListener = null;
+        mListenerDeath = null;
+    }
+
+    private static void refused(@Nullable IRoseEdgeListener listener, int displayId, int taskId, int reason) {
+        if (listener == null) return;
+        try {
+            listener.onRefused(displayId, taskId, reason);
+        } catch (RemoteException e) {
+            Slog.w(TAG, "onRefused not delivered", e);
+        }
+    }
+
+    private static void lowered(@Nullable IRoseEdgeListener listener, int displayId, int reason) {
+        if (listener == null) return;
+        try {
+            listener.onLowered(displayId, reason);
+        } catch (RemoteException e) {
+            Slog.w(TAG, "onLowered not delivered", e);
+        }
+    }
+
+    // RemoteCallable and the exported binder.
+
+    @Override
+    public Context getContext() {
+        return mContext;
+    }
+
+    @Override
+    public ShellExecutor getRemoteCallExecutor() {
+        return mMainExecutor;
+    }
+
+    private ExternalInterfaceBinder createExternalInterface() {
+        return new IRoseEdgeImpl(this);
+    }
+
+    /** The binder Launcher3 receives; every call checks MANAGE_ACTIVITY_TASKS on the caller's identity. */
+    private static class IRoseEdgeImpl extends IRoseEdge.Stub implements ExternalInterfaceBinder {
+        private RoseEdgeController mController;
+
+        IRoseEdgeImpl(RoseEdgeController controller) {
+            mController = controller;
+        }
+
+        @Override
+        public void invalidate() {
+            final RoseEdgeController controller = mController;
+            mController = null;
+            if (controller != null) {
+                controller.mMainExecutor.execute(controller::onInterfaceInvalidated);
+            }
+        }
+
+        @Override
+        public void raise(int displayId, int taskId, int liftPx, IRoseEdgeListener listener) {
+            executeRemoteCallWithTaskPermission(mController, "raise",
+                    (controller) -> controller.raise(displayId, taskId, liftPx, listener));
+        }
+
+        @Override
+        public void lower(int displayId) {
+            executeRemoteCallWithTaskPermission(mController, "lower",
+                    (controller) -> controller.requestLower(displayId));
+        }
+    }
+}
