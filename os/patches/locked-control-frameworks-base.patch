+    /**
+     * Whether the pinned prototype agent may create a session while the owner's device is
+     * locked or its screen is off. This never unlocks the keyguard: the session runs only on its
+     * own always-unlocked virtual display. Every condition below is re-evaluated at creation.
+     */
+    boolean isLockedSessionAllowed(@Nullable String packageName,
+            @NonNull PackageManager packageManager, @UserIdInt int userId) {
+        final Resources resources = mContext.getResources();
+        if (!resources.getBoolean(R.bool.config_pixelComputerControlLockedSessions)) {
+            return false;
+        }
+        if (!hasPrototypeControl(packageName, packageManager)) {
+            Slog.w(TAG, "Locked session refused: agent is not the pinned prototype agent");
+            return false;
+        }
+        // Credential-encrypted storage must already be unlocked by the owner since boot.
+        final UserManager userManager = mContext.getSystemService(UserManager.class);
+        if (userManager == null || !userManager.isUserUnlocked(UserHandle.of(userId))) {
+            Slog.w(TAG, "Locked session refused: user storage is still locked");
+            return false;
+        }
+        final LockPatternUtils lockPatternUtils = new LockPatternUtils(mContext);
+        if (!lockPatternUtils.isSecure(userId)) {
+            Slog.w(TAG, "Locked session refused: no secure lock screen");
+            return false;
+        }
+        // Refuse whenever Android would refuse a biometric unlock: after boot, lockdown,
+        // the strong-auth timeout, failed attempts or a device policy requirement.
+        if (lockPatternUtils.getStrongAuthForUser(userId)
+                != LockPatternUtils.StrongAuthTracker.STRONG_AUTH_NOT_REQUIRED) {
+            Slog.w(TAG, "Locked session refused: strong authentication is required");
+            return false;
+        }
+        final long maxAgeMs = resources.getInteger(
+                R.integer.config_pixelComputerControlLockedAuthMaxAgeMs);
+        final BiometricManager biometricManager =
+                mContext.getSystemService(BiometricManager.class);
+        final long lastAuthentication = biometricManager == null
+                ? BiometricManager.BIOMETRIC_NO_AUTHENTICATION
+                : biometricManager.getLastAuthenticationTime(userId,
+                        BiometricManager.Authenticators.DEVICE_CREDENTIAL
+                                | BiometricManager.Authenticators.BIOMETRIC_STRONG);
+        if (maxAgeMs <= 0 || lastAuthentication == BiometricManager.BIOMETRIC_NO_AUTHENTICATION
+                || SystemClock.elapsedRealtime() - lastAuthentication > maxAgeMs) {
+            Slog.w(TAG, "Locked session refused: no recent owner authentication");
+            return false;
+        }
+        return true;
+    }
