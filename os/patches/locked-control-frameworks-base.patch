+                        packageName, userId)
+                || isKnownPackage(packageManagerInternal, KnownPackages.PACKAGE_INSTALLER,
+                        packageName, userId)
+                || isKnownPackage(packageManagerInternal, KnownPackages.PACKAGE_UNINSTALLER,
+                        packageName, userId)
+                || isKnownPackage(packageManagerInternal, KnownPackages.PACKAGE_VERIFIER,
+                        packageName, userId)
+                || isKnownPackage(packageManagerInternal,
