 "versionCheck": {
  "path": "vendor/google_devices/frankel/adevtool-version-check.mk",
  "writer": {
   "project": "vendor/adevtool",
   "revision": "17df3b79a73e67ad68387b35c7d41c85e1d8103c",
   "path": "src/blobs/build.ts",
   "line": 38,
   "text": "export async function writeVersionCheckFile(config: DeviceConfig, dirs: VendorDirectories, warnOnly: boolean = false) {",
   "template": [
    "let contents =",
    "`ifneq ($(shell git -C ${RELATIVE_ADEVTOOL_PATH} rev-parse HEAD),${adevtoolRevision})\\n` +",
    "`  $(${warnOnly ? 'warning' : 'error'} ${deviceName} vendor module is outdated. Run \\`adevtool generate-all -d ${deviceName}\\` to update it)\\n` +",
    "`endif`"
   ]
  },
  "expected": {
   "revision": "17df3b79a73e67ad68387b35c7d41c85e1d8103c",
   "form": "error",
   "error": {
    "sha256": "ecb7d5333dc39e40e77b3fe50de413f67cacabc7b877d26f03b078361fbc68c4",
    "gitBlob": "c879f87d1145da4cf90399aa2bccdcea8a4cf326",
    "bytes": 199
   },
   "warning": {
    "sha256": "c2ae74310968fba1d83d81fc374ee68e984fc09224e04d472a239b6dd1481af2",
    "gitBlob": "b8d74c2f89eb8b3a5170cd146a879083c80c52d8",
    "bytes": 201
   }
  },
  "formRule": "only the error form is accepted. generate-all writes the warning form only with --noVerify, which also skips the comparison of the generated vendor module with its reference FileTreeSpec, so a warning-form module is unverified vendor provenance and is refused",
  "formSource": {
   "project": "vendor/adevtool",
   "revision": "17df3b79a73e67ad68387b35c7d41c85e1d8103c",
   "path": "src/commands/generate-all.ts",
   "line": 329,
   "text": "await writeVersionCheckFile(config, vendorDirs, flags.noVerify)"
  },
  "includedFrom": {
   "path": "vendor/google_devices/frankel/frankel.mk",
   "line": 4,
   "text": "include vendor/google_devices/frankel/adevtool-version-check.mk"
  },
  "selectedBy": {
   "path": "vendor/google_devices/frankel/AndroidProducts.mk",
   "text": "PRODUCT_MAKEFILES += $(LOCAL_DIR)/frankel.mk",
   "productConfig": {
    "project": "build/make",
    "revision": "b0f697df8cc9519408ca0a404e918cd51bde0735",
    "path": "core/product_config.mk",
    "line": 212,
    "text": "current_product_makefile := $(call _second,$(filter $(TARGET_PRODUCT):%,$(product_paths)),:)"
   }
  },
  "executes": {
   "make": "$(shell git -C vendor/adevtool rev-parse HEAD)",
   "argv": [
    "git",
    "-C",
    "vendor/adevtool",
    "rev-parse",
    "HEAD"
   ],
   "cwd": "the source root",
   "compare": "$(shell) stdout, trailing newline removed, must equal expected.revision exactly"
  },
  "runsIn": [
   "lunch: build_build_var_cache runs soong_ui --dumpvars-mode, whose product configuration imports frankel.mk for TARGET_PRODUCT=frankel",
   "m: the same product configuration again (its dumpvars and the main kati run)"
  ],
  "lunchSource": {
   "project": "build/make",
   "revision": "b0f697df8cc9519408ca0a404e918cd51bde0735",
   "path": "envsetup.sh",
   "line": 69,
   "text": "build_dicts_script=`\\builtin cd $T; build/soong/soong_ui.bash --dumpvars-mode \\"
  },
  "skipSwitch": null,
  "inFileTreeSpec": false,
  "withoutGit": "git exits non-zero with nothing on stdout, the comparison fails and the error form stops lunch with \"frankel vendor module is outdated\""
 },
 "gitRequirement": {
  "project": "vendor/adevtool",
  "revision": "17df3b79a73e67ad68387b35c7d41c85e1d8103c",
  "rootTree": "f0863541755769c12b01f5e1a429bdc6cb704f07",
  "path": "vendor/adevtool/.git",
  "functionalMinimum": "git accepts a directory with a valid HEAD and enterable objects/ and refs/ as a repository, and rev-parse HEAD on a detached HEAD reads no object; so a lunch that passes the check does not show that the Git data is genuine (os/tests/test_frankel_lunch_inputs.py demonstrates it)",
  "genuineSource": {
   "link": "vendor/adevtool/.git",
   "linkText": "../../.repo/projects/vendor/adevtool.git",
   "gitdir": ".repo/projects/vendor/adevtool.git",
   "basis": "repo checks a project out with .git as a link into .repo/projects; observation 41566744429 recorded this link text on the production tree, which is historical evidence, not current state"
  },
  "acceptance": [
   "HEAD is exactly revision plus one newline",
   "in the copy, with GIT_* stripped and GIT_CEILING_DIRECTORIES at the copy root, git -C vendor/adevtool rev-parse HEAD prints exactly revision, cat-file -t revision is commit and revision^{tree} is rootTree",
   "these checks rule out an empty or redirected store but do not prove a complete one: the gitdir and the object store it uses are copied byte for byte from genuineSource under an approval that names exact paths and bounds"
  ],
  "options": [
   {
    "class": "genuine-copy",
    "status": "allowed only under a separate approval with exact paths and bounds; Release owns the mechanism"
   },
   {
    "class": "redirect",
    "status": "refused",
    "means": "GIT_DIR, a link, alternates or any other way of pointing the copy at the production gitdir"
   },
   {
    "class": "fabrication",
    "status": "refused",
    "means": "any HEAD, ref, object or gitdir written rather than copied"
   },
   {
    "class": "relaxation",
    "status": "refused",
    "means": "regenerating the vendor module with --noVerify, or editing, replacing or removing adevtool-version-check.mk or frankel.mk"
   }
  ],
  "environment": {
   "GIT_CEILING_DIRECTORIES": "the copy root",
   "strip": "GIT_*",
   "why": "without a ceiling git searches above the copy, and a parent repository would answer with a foreign HEAD"
  },
  "otherGit": "none: in the pinned public sources nothing else needs .git or a git process for this lunch and Launcher3QuickStepLib (every *.mk and *.bp of the pinned manifest was searched, #410); content the generated vendor module adds beyond its reference is not covered"
 },
