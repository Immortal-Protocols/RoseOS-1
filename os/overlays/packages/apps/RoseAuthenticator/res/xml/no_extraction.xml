<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: neither cloud backup nor device-to-device transfer carries the sealed secrets
     (the Keystore key that opens them never leaves the device either). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
