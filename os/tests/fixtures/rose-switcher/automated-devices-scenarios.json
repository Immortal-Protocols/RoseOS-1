{
  "contract": "#156 AutomatedPackageListener.onAutomatedDevicesChanged(long generation, int[] deviceIds, String[] ownerPackages, int[] ownerUids), relayed to OS Core 19:51:27Z",
  "controller": "dev.pixel.backgroundcontrol",
  "controllerUid": 10123,
  "user": 0,
  "note": "Consumer half: snapshots are what the producer sends (complete, per registration, generation rising on every change); sessionDevices is getVirtualDevices() COMPUTER_CONTROL display->device as read; released are session displays seen before and gone now. expect is the Launcher3 row. Synthetic ids and packages, not captured output.",
  "scenarios": [
    {"name": "1a initial empty snapshot, no session task",
     "events": [{"snapshot": [1, [], [], []]}],
     "sessionDevices": {}, "released": [],
     "tasks": [[1, 0, 0, "com.human.app", true]],
     "expect": {"state": "EMPTY", "cards": [], "unconfirmed": [], "reason": "No background work"}},
    {"name": "1b initial empty snapshot, a session task before its ownership arrives",
     "events": [{"snapshot": [1, [], [], []]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [2], "reason": "Rose's work can't be confirmed right now"}},
    {"name": "1c registered, no snapshot yet",
     "events": [],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [], "reason": "Rose's work has not been reported yet"}},
    {"name": "2 Rose's session alone",
     "events": [{"snapshot": [1, [7], ["dev.pixel.backgroundcontrol"], [10123]]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true], [3, 7, 0, "com.example.maps", false]],
     "expect": {"state": "AVAILABLE", "cards": [2, 3], "unconfirmed": [], "reason": null}},
    {"name": "3 another owner runs the same app on a second session device",
     "events": [{"snapshot": [1, [7], ["dev.pixel.backgroundcontrol"], [10123]]},
                {"snapshot": [2, [7, 11], ["dev.pixel.backgroundcontrol", "com.other.agent"], [10123, 10456]]}],
     "sessionDevices": {"7": 7, "11": 11}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true], [9, 11, 0, "com.example.mail", true]],
     "expect": {"state": "AVAILABLE", "cards": [2], "unconfirmed": [], "reason": null}},
    {"name": "3 the other device's ownership not yet reported",
     "events": [{"snapshot": [1, [7], ["dev.pixel.backgroundcontrol"], [10123]]}],
     "sessionDevices": {"7": 7, "11": 11}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true], [9, 11, 0, "com.example.mail", true]],
     "expect": {"state": "AVAILABLE", "cards": [2], "unconfirmed": [9], "reason": "Rose's work can't be confirmed right now"}},
    {"name": "4 Rose's session closed, stale entry, the other device's task",
     "events": [{"snapshot": [3, [7, 11], ["dev.pixel.backgroundcontrol", "com.other.agent"], [10123, 10456]]}],
     "sessionDevices": {"11": 11}, "released": [7],
     "tasks": [[9, 11, 0, "com.example.mail", true]],
     "expect": {"state": "EMPTY", "cards": [], "unconfirmed": [], "reason": "No background work"}},
    {"name": "5 released session display still holding a task",
     "events": [{"snapshot": [3, [7], ["dev.pixel.backgroundcontrol"], [10123]]}],
     "sessionDevices": {}, "released": [7],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [2], "reason": "Rose's work can't be confirmed right now"}},
    {"name": "6 equal or lower generation ignored",
     "events": [{"snapshot": [5, [7], ["dev.pixel.backgroundcontrol"], [10123]]},
                {"snapshot": [5, [7], ["com.other.agent"], [10456]]},
                {"snapshot": [4, [], [], []]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "AVAILABLE", "cards": [2], "unconfirmed": [], "reason": null}},
    {"name": "7 reconnect clears state; not reported until the new initial snapshot",
     "events": [{"snapshot": [9, [7], ["dev.pixel.backgroundcontrol"], [10123]]}, {"reset": true}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [], "reason": "Rose's work has not been reported yet"}},
    {"name": "7 the new service lifetime's initial snapshot restores, lower generation",
     "events": [{"snapshot": [9, [7], ["dev.pixel.backgroundcontrol"], [10123]]}, {"reset": true},
                {"snapshot": [1, [7], ["dev.pixel.backgroundcontrol"], [10123]]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "AVAILABLE", "cards": [2], "unconfirmed": [], "reason": null}},
    {"name": "8 another user's controller session (that user's uid)",
     "events": [{"snapshot": [1, [7], ["dev.pixel.backgroundcontrol"], [1010123]]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "EMPTY", "cards": [], "unconfirmed": [], "reason": "No background work"}},
    {"name": "9 simultaneous app swap across two owners",
     "events": [{"snapshot": [2, [7, 11], ["dev.pixel.backgroundcontrol", "com.other.agent"], [10123, 10456]]}],
     "sessionDevices": {"7": 7, "11": 11}, "released": [],
     "tasks": [[5, 7, 0, "com.example.maps", true], [9, 11, 0, "com.example.mail", true]],
     "expect": {"state": "AVAILABLE", "cards": [5], "unconfirmed": [], "reason": null}},
    {"name": "malformed: unequal arrays",
     "events": [{"snapshot": [1, [7], ["dev.pixel.backgroundcontrol"], [10123]]},
                {"snapshot": [2, [7, 8], ["dev.pixel.backgroundcontrol"], [10123, 10123]]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [], "reason": "Rose's work could not be read (ownership)"}},
    {"name": "malformed: null array",
     "events": [{"snapshot": [2, null, ["dev.pixel.backgroundcontrol"], [10123]]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [], "reason": "Rose's work could not be read (ownership)"}},
    {"name": "malformed: duplicate device",
     "events": [{"snapshot": [2, [7, 7], ["dev.pixel.backgroundcontrol", "com.other.agent"], [10123, 10456]]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [], "reason": "Rose's work could not be read (ownership)"}},
    {"name": "malformed: empty owner package, negative uid, generation 0",
     "events": [{"snapshot": [1, [7], [""], [10123]]}, {"snapshot": [2, [7], ["dev.pixel.backgroundcontrol"], [-1]]},
                {"snapshot": [0, [], [], []]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "UNAVAILABLE", "cards": [], "unconfirmed": [], "reason": "Rose's work could not be read (ownership)"}},
    {"name": "malformed then valid: baseline kept, next higher generation restores",
     "events": [{"snapshot": [3, [7], ["dev.pixel.backgroundcontrol"], [10123]]},
                {"snapshot": [4, [7], [null], [10123]]},
                {"snapshot": [3, [7], ["dev.pixel.backgroundcontrol"], [10123]]},
                {"snapshot": [4, [7], ["dev.pixel.backgroundcontrol"], [10123]]}],
     "sessionDevices": {"7": 7}, "released": [],
     "tasks": [[2, 7, 0, "com.example.mail", true]],
     "expect": {"state": "AVAILABLE", "cards": [2], "unconfirmed": [], "reason": null}}
  ]
}
