{
 "contract": "#156/#225 current-apps parity: the switcher's Rose row (Launcher3) and Rose's apps (Home) show the SAME set, or the same explicit cannot-confirm state.",
 "categories": {
  "cards": "a complete, same-user list: exactly these packages are shown, nothing else",
  "genuine_empty": "attested complete and empty: 'not using any apps'",
  "cannot_confirm": "incomplete, unavailable, locked, malformed or not yet reported: no app cards at all, an explicit status, never genuine_empty"
 },
 "scope": "Membership scope is every live ComputerControl session device that the controller owns for the current user. The controller runs at most one session (it closes the old one before starting another), so Home's single controller reply and Launcher3's per-device snapshot describe the same scope. If Launcher3 ever sees more than one live controller-owned device, or any of them incomplete, the whole row is cannot_confirm.",
 "inputs": {
  "platform": "the per-device view both sources come from: devices[{owner: controller|other, complete, apps}] (PR361 listener / getAutomatedApps)",
  "controllerReply": "the phone-local call(\"current_apps\") reply App Core derives from it (PR364 shape)"
 },
 "cases": [
  {
   "name": "complete_list",
   "platform": {
    "devices": [
     {
      "owner": "controller",
      "complete": true,
      "apps": [
       "com.android.calculator2",
       "com.google.android.apps.maps"
      ]
     }
    ]
   },
   "controllerReply": {
    "status": "live",
    "sessionId": "s-1",
    "taskId": "rose-ws-1",
    "sessionStatus": "ready",
    "generation": 4,
    "complete": true,
    "incompleteReason": "",
    "source": "platform",
    "apps": [
     {
      "packageName": "com.google.android.apps.maps",
      "front": true,
      "target": false
     },
     {
      "packageName": "com.android.calculator2",
      "front": false,
      "target": true
     }
    ]
   },
   "expected": {
    "category": "cards",
    "apps": [
     "com.android.calculator2",
     "com.google.android.apps.maps"
    ]
   }
  },
  {
