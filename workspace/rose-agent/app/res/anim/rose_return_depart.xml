<?xml version="1.0" encoding="utf-8"?>
<!-- 1C, V3: Rose fades and moves down 8dp over 200 ms as the source app returns. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200" android:interpolator="@interpolator/rose_return_ease" android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0"/>
    <translate android:fromYDelta="0" android:toYDelta="8dp"/>
</set>
