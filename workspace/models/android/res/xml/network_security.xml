<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, platform trust anchors only. No user CAs, no cleartext exceptions. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
