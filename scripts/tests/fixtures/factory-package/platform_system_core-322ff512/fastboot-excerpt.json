   "104": "RetCode FastBootDriver::GetVar(const std::string& key, std::string* val,",
   "105": "                               std::vector<std::string>* info) {",
   "106": "    if (auto fc = flash_capturer()) {",
   "107": "        if (auto maybe_val = fc->vars_.find(key); maybe_val != fc->vars_.end()) {",
   "108": "            *val = maybe_val->second;",
   "109": "            return fastboot::SUCCESS;",
   "110": "        }",
   "111": "",
   "112": "        die(\"unexpected GetVar: %s\", key.c_str());",
   "113": "    }",
   "114": "",
   "115": "    return RawCommand(FB_CMD_GETVAR \":\" + key, val, info);",
   "150": "}",
