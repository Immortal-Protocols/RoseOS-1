   "1875": "        // aiz stands for android-info.zip",
   "1876": "        int aiz_fd = make_temporary_fd(\"android-info-zip\"); // dies on failure",
   "1877": "        FILE* aiz_file = fdopen(aiz_fd, \"wb\");",
   "1878": "        if (aiz_file == nullptr) {",
   "1879": "            die(\"fdopen(android_zip_fd): %s\", strerror(errno));",
   "1880": "        }",
   "1881": "        ZipWriter aiz(aiz_file);",
   "1882": "        if (int ret = aiz.StartEntry(\"fastboot-info.txt\", ZipWriter::kCompress)) {",
   "1883": "            die(\"android_info_zip.StartEntry(fastboot-info): %s\", ErrorCodeString(ret));",
   "1884": "        }",
   "1885": "        const char* fastboot_info = \"version 1\\n\";",
   "1886": "        if (int ret = aiz.WriteBytes(fastboot_info, strlen(fastboot_info))) {",
   "1887": "            die(\"android_info_zip.WriteBytes(fastboot-info): %s\", ErrorCodeString(ret));",
   "1888": "        }",
   "1889": "        if (int ret = aiz.FinishEntry()) {",
   "1890": "            die(\"android_info_zip.FinishEntry(fastboot-info): %s\", ErrorCodeString(ret));",
   "1891": "        }",
   "1892": "        if (int ret = aiz.StartEntry(\"android-info.txt\", ZipWriter::kCompress)) {",
   "1893": "            die(\"android_info_zip.StartEntry(android-info): %s\", ErrorCodeString(ret));",
   "1894": "        }",
   "1895": "        if (int ret = aiz.WriteBytes(contents.data(), contents.size())) {",
   "1896": "            die(\"android_info_zip.WriteBytes(android-info): %s\", ErrorCodeString(ret));",
   "1897": "        }",
   "1898": "        if (int ret = aiz.FinishEntry()) {",
   "1899": "            die(\"android_info_zip.FinishEntry(android-info): %s\", ErrorCodeString(ret));",
   "1900": "        }",
   "1901": "        if (int ret = aiz.Finish()) {",
   "1902": "            die(\"android_info_zip.Finish(): %s\", ErrorCodeString(ret));",
   "1903": "        }",
   "1904": "        int64_t aiz_fd_len = lseek64(aiz_fd, 0L, SEEK_END);",
   "1905": "        if (aiz_fd_len < 0) {",
   "1906": "            die(\"lseek64(android_info_zip_fd, SEEK_END): %s\", strerror(errno));",
   "1907": "        }",
   "1908": "",
   "1909": "        std::vector<uint8_t> android_info_zip_contents(aiz_fd_len);",
   "1910": "        if (!android::base::ReadFullyAtOffset(aiz_fd, android_info_zip_contents.data(), aiz_fd_len, 0)) {",
   "1911": "            die(\"ReadFully(android_info_zip_fd): %s\", strerror(errno));",
   "1912": "        }",
   "1913": "",
   "1914": "        if (fclose(aiz_file) != 0) {",
   "1915": "            die(\"fclose(android_info_zip_file): %s\", strerror(errno));",
   "1916": "        }",
   "1917": "",
   "1918": "        std::string aiz_name = \"android-info.zip\";",
   "1919": "        fc->AddFile(aiz_name, android_info_zip_contents.data(), android_info_zip_contents.size());",
   "1920": "",
   "1921": "        fc->AddShBatComment(\"this command only checks android-info.txt requirements, it does not perform an update\");",
