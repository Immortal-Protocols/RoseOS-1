   "2807": "static void parse_flash_all_sh(FlashCapturer& fc, FlashingPlan* flashing_plan, std::string& contents) {",
   "2808": "    std::vector<std::string> lines = android::base::Split(contents, \"\\n\");",
   "2809": "",
   "2810": "    int bootloader_flash_counter = 0;",
   "2811": "    bool added_set_active_a = false;",
   "2812": "",
   "2813": "    for (std::string& line : lines) {",
   "2814": "        if (!line.starts_with(\"fastboot \")) {",
   "2815": "            continue;",
   "2816": "        }",
   "2817": "",
   "2818": "        if (line.find(\" update image-\") != std::string::npos) {",
   "2819": "            // \"fastboot update\" is handled separately",
   "2820": "            break;",
   "2821": "        }",
   "2822": "",
   "2823": "        std::vector<std::string> tokens = android::base::Tokenize(line, \" \");",
   "2824": "",
   "2825": "        if (tokens.size() < 2 || tokens[0] != \"fastboot\") {",
   "2826": "            die(\"invalid flash-all line %s\", line.c_str());",
   "2827": "        }",
   "2828": "",
   "2829": "        size_t token_count = 0;",
   "2830": "",
   "2831": "        if (tokens[1] == \"flash\") {",
   "2832": "            bool other_slot = false;",
   "2833": "            size_t partition_idx = 2;",
   "2834": "            size_t file_idx = 3;",
   "2835": "            token_count = 4;",
   "2836": "            if (tokens[2] == \"--slot=other\") {",
   "2837": "                other_slot = true;",
   "2838": "                ++partition_idx;",
   "2839": "                ++file_idx;",
   "2840": "                ++token_count;",
   "2841": "            }",
   "2842": "            // at() is used intentionally for bounds checking",
   "2843": "            std::string& partition = tokens.at(partition_idx);",
   "2844": "            std::string& file = tokens.at(file_idx);",
   "2845": "",
   "2846": "            if (partition == \"bootloader\") {",
   "2847": "                if (!other_slot) {",
   "2848": "                    die(\"unexpected bootloader flash command\");",
   "2849": "                }",
   "2850": "                ++bootloader_flash_counter;",
   "2851": "            }",
   "2852": "",
   "2853": "            fc.AddCommand((\"flash \" + partition).append(\" \").append(file)",
   "2854": "                                  .append(other_slot ? \" other-slot\" : \"\"));",
   "2855": "            fc.AddShBatCommand(line);",
   "2856": "        } else if (tokens[1] == \"--set-active=other\") {",
   "2857": "            token_count = 2;",
   "2858": "            fc.AddCommand(\"toggle-active-slot\");",
   "2859": "            fc.AddShBatCommand(line);",
   "2860": "        } else if (tokens[1] == \"reboot-bootloader\") {",
   "2861": "            token_count = 2;",
   "2862": "            fc.AddCommand(tokens[1]);",
   "2863": "            fc.AddShBatCommand(line);",
   "2864": "            fc.AddShLine(\"sleep 5\");",
   "2865": "            fc.AddBatLine(\"ping -n 5 127.0.0.1 >nul\");",
   "2866": "            if (bootloader_flash_counter == 2 && !added_set_active_a) {",
   "2867": "                fc.AddComment(\"size of partition splits depends on this value\");",
   "2868": "                std::stringstream max_dl_size_hex;",
   "2869": "                max_dl_size_hex << \"0x\" << std::hex << flashing_plan->sparse_limit;",
   "2870": "                fc.AddCheckVarCommand(\"max-download-size\", max_dl_size_hex.str());",
   "2871": "",
   "2872": "                fc.AddComment(\"layout of the super partition depends on the current slot, which is hardcoded to slot A\");",
   "2873": "                fc.AddCommand(\"run-cmd set_active:a\");",
   "2874": "                fc.AddShBatCommand(\"fastboot --set-active=a\");",
   "2875": "                added_set_active_a = true;",
   "2876": "",
   "2877": "                fc.AddCheckVarCommand(\"current-slot\", \"a\");",
   "2878": "            }",
   "2879": "        } else if (tokens[1] == \"erase\") {",
   "2880": "            token_count = 3;",
   "2881": "            std::string& partition = tokens.at(2);",
   "2882": "            fc.AddCommand(\"erase \" + partition);",
   "2883": "            fc.AddShBatCommand(\"fastboot erase \" + partition);",
   "2884": "        } else if (tokens[1] == \"snapshot-update\") {",
   "2885": "            token_count = 3;",
   "2886": "            if (tokens.at(2) != \"cancel\") {",
   "2887": "                die(\"unexpected flash-all command: %s\", line.c_str());",
   "2888": "            }",
   "2889": "            fc.AddCommand(\"maybe-cancel-snapshot-update\");",
   "2890": "            fc.AddShBatCommand(line);",
   "2891": "        } else if (tokens[1] == \"oem\") {",
   "2892": "            auto cmd = std::string(\"run-cmd\");",
   "2893": "            for (size_t i = 1; i < tokens.size(); ++i) {",
   "2894": "                cmd.append(\" \").append(tokens[i]);",
   "2895": "            }",
   "2896": "            fc.AddCommand(cmd);",
   "2897": "            token_count = tokens.size();",
   "2898": "            fc.AddShBatCommand(line);",
   "2899": "        }",
   "2900": "        else {",
   "2901": "            die(\"unknown flash-all command %s\", line.c_str());",
   "2902": "        }",
   "2903": "",
   "2904": "        if (tokens.size() != token_count) {",
   "2905": "            die(\"unexpected number of tokens: %s\", line.c_str());",
   "2906": "        }",
   "2907": "    }",
   "2908": "",
   "2909": "    if (bootloader_flash_counter != 2) {",
   "2910": "        die(\"unexpected number of flash bootloader commands: %i\", bootloader_flash_counter);",
   "2911": "    }",
   "2912": "}",
