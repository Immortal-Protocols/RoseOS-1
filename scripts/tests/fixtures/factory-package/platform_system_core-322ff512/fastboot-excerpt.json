   "2920": "void FlashCapturer::Run(FlashingPlan* flashing_plan, std::string& factory_path, std::string& out_path) {",
   "2921": "    flashing_plan->wants_wipe = true; // needed for capture of wipe commands",
   "2922": "",
   "2923": "    ZipArchiveHandle factory_zip;",
   "2924": "    if (int ret = OpenArchive(factory_path.c_str(), &factory_zip)) {",
   "2925": "        die(\"unable to open factory zip: %s\", ErrorCodeString(ret));",
   "2926": "    }",
   "2927": "",
   "2928": "    std::string tmp_out_path = out_path + \".tmp\";",
   "2929": "    output_zip_writer_file_ = fopen(tmp_out_path.c_str(), \"wb\");",
   "2930": "    if (output_zip_writer_file_ == nullptr) {",
   "2931": "        die(\"unable to create out file %s: %s\", out_path.c_str(), strerror(errno));",
   "2932": "    }",
   "2933": "",
   "2934": "    output_zip_writer_ = new ZipWriter(output_zip_writer_file_);",
   "2935": "",
   "2936": "    void* zip_iter_cookie;",
   "2937": "",
   "2938": "    if (int ret = StartIteration(factory_zip, &zip_iter_cookie)) {",
   "2939": "        die(\"factory zip StartIteration failed: %s\", ErrorCodeString(ret));",
   "2940": "    }",
   "2941": "",
   "2942": "    ZipArchiveHandle update_zip = nullptr;",
   "2943": "",
   "2944": "    static_assert(sizeof(uint8_t) == sizeof(char), \"unexpected char size\");",
   "2945": "    std::string flash_all_sh;",
   "2946": "    std::string flash_all_bat;",
   "2947": "    std::string product_name;",
   "2948": "",
   "2949": "    for (;;) {",
   "2950": "        ZipEntry64 entry;",
   "2951": "        std::string entry_name;",
   "2952": "        int ret = Next(zip_iter_cookie, &entry, &entry_name);",
   "2953": "        if (ret == -1) {",
   "2954": "            EndIteration(zip_iter_cookie);",
   "2955": "            zip_iter_cookie = nullptr;",
   "2956": "            break;",
   "2957": "        }",
   "2958": "        if (ret) {",
   "2959": "            die(\"factory zip iteration failed: %s\", ErrorCodeString(ret));",
   "2960": "        }",
   "2961": "",
   "2962": "        std::string entry_base_name = entry_name.substr(entry_name.find_last_of('/') + 1);",
   "2963": "",
   "2964": "        if (entry_base_name.empty()) {",
   "2965": "            // entry is a directory",
   "2966": "            continue;",
   "2967": "        }",
   "2968": "",
   "2969": "        if (entry_base_name.starts_with(\"image-\") && entry_base_name.ends_with(\".zip\")) {",
   "2970": "            size_t product_name_start = strlen(\"image-\");",
   "2971": "            size_t product_name_end = entry_base_name.find(\"-\", product_name_start);",
   "2972": "            if (product_name_end == std::string::npos) {",
   "2973": "                die(\"product_name_end not found\");",
   "2974": "            }",
   "2975": "            product_name = entry_base_name.substr(product_name_start, product_name_end - product_name_start);",
   "2976": "",
