  "fastboot/task.cpp": {
   "278": "void OptimizedFlashSuperTask::Run() {",
   "279": "    // Use the reported super partition size as the upper limit, rather than",
   "280": "    // sparse_file_len, which (1) can fail and (2) is kind of expensive, since",
   "281": "    // it will map in all of the embedded fds.",
   "282": "    std::vector<SparsePtr> files;",
   "283": "    if (int limit = get_sparse_limit(super_size_, fp_)) {",
   "284": "        if (!split_file(sparse_layout_.get(), limit, &files)) {",
   "285": "            LOG(FATAL) << \"Failed to resparse super partition\";",
   "286": "        }",
   "287": "    } else {",
   "288": "        if (has_flash_capturer()) {",
   "289": "            die(\"unexpected sparse limit %i\", limit);",
   "290": "        }",
   "291": "        files.emplace_back(std::move(sparse_layout_));",
   "292": "    }",
   "293": "",
   "294": "    if (auto fc = flash_capturer()) {",
   "295": "        fc->AddSplitSparsePartition(\"super\", files);",
   "296": "    } else {",
   "297": "        // Send the data to the device.",
   "298": "        flash_partition_files(fp_->fb, super_name_, files);",
   "355": "    }",
   "356": "",
   "357": "    std::string super_name;",
   "358": "    // Try to find whether there is a super partition.",
   "359": "    if (fp->fb->GetVar(\"super-partition-name\", &super_name) != fastboot::SUCCESS) {",
   "360": "        super_name = \"super\";",
   "361": "    }",
   "362": "    uint64_t partition_size;",
   "363": "    if (has_flash_capturer()) {",
   "364": "        partition_size = fp->sparse_limit + 1;",
   "365": "    } else {",
   "366": "        std::string partition_size_str;",
   "367": "        if (fp->fb->GetVar(\"partition-size:\" + super_name, &partition_size_str) != fastboot::SUCCESS) {",
   "368": "            LOG(VERBOSE) << \"Cannot optimize super flashing: could not determine super partition\";",
   "483": "WipeTask::WipeTask(const FlashingPlan* fp, const std::string& pname) : fp_(fp), pname_(pname){};",
   "484": "",
   "485": "void WipeTask::Run() {",
   "486": "    if (auto fc = flash_capturer()) {",
   "487": "        std::string cmd = \"erase \" + pname_;",
   "488": "        fc->AddCommand(cmd);",
