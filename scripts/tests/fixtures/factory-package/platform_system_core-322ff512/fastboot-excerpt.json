   "3132": "",
   "3133": "static std::string size_to_string(size_t v) {",
   "3134": "    if (v >= (10 * (1 << 20))) {",
   "3135": "        return std::to_string(v >> 20).append(\" MiB\");",
   "3136": "    }",
   "3137": "    if (v >= (10 * (1 << 10))) {",
   "3138": "        return std::to_string(v >> 10).append(\" KiB\");",
   "3139": "    }",
   "3140": "    return std::to_string(v).append(\" B\");",
   "3141": "}",
   "3142": "",
   "3143": "void FlashCapturer::AddFile(const std::string& name, const void* data, size_t len, size_t flags) {",
   "3144": "    StartOutputZipEntry(name, flags);",
   "3145": "    if (int ret = output_zip_writer_->WriteBytes(data, len)) {",
   "3146": "        die(\"AddFile: WriteBytes: %s\", ErrorCodeString(ret));",
   "3147": "    }",
   "3148": "    FinishOutputZipEntry();",
   "3149": "    ZipWriter::FileEntry entry;",
   "3150": "    if (int ret = output_zip_writer_->GetLastEntry(&entry)) {",
   "3151": "        die(\"AddSparseFileInner: GetLastEntry: %s\", ErrorCodeString(ret));",
   "3152": "    }",
   "3153": "    std::cerr << \"FlashCapturer: added \" << name << \", \"",
   "3154": "              << size_to_string(entry.uncompressed_size)",
   "3155": "              << \" (\" << size_to_string(entry.compressed_size) << \")\\n\";",
   "3156": "}",
   "3157": "",
   "3158": "void FlashCapturer::AddSparseFileInner(struct sparse_file *s, const std::string &name, size_t flags) {",
   "3159": "    StartOutputZipEntry(name, flags);",
   "3160": "    auto cb = [](void* priv, const void* buf, size_t len) -> int {",
   "3161": "        auto w = static_cast<ZipWriter*>(priv);",
   "3162": "        if (int ret = w->WriteBytes(buf, len)) {",
   "3163": "            die(\"AddSparseFileInner: WriteBytes: %s\", ErrorCodeString(ret));",
   "3164": "        }",
   "3165": "        return 0;",
   "3166": "    };",
   "3167": "    if (int ret = sparse_file_callback(s, true, false, cb, output_zip_writer_)) {",
   "3168": "        die(\"AddSparseFileInner: sparse_file_callback: %s\", strerror(-ret));",
   "3169": "    }",
   "3170": "    FinishOutputZipEntry();",
   "3171": "    ZipWriter::FileEntry entry;",
   "3172": "    if (int ret = output_zip_writer_->GetLastEntry(&entry)) {",
   "3173": "        die(\"AddSparseFileInner: GetLastEntry: %s\", ErrorCodeString(ret));",
   "3174": "    }",
   "3175": "    std::cerr << \"FlashCapturer: added sparse \" << name << \", \"",
   "3176": "              << size_to_string(entry.uncompressed_size)",
   "3177": "              << \" (\" << size_to_string(entry.compressed_size) << \")\\n\";",
   "3178": "}",
   "3179": "",
   "3180": "void FlashCapturer::AddSparsePartition(struct sparse_file *s, size_t flags) {",
   "3181": "    if (pending_file_name_ == nullptr) {",
   "3182": "        die(\"AddSparseFile: no pending partition name\");",
   "3183": "    }",
   "3184": "    AddSparseFileInner(s, *pending_file_name_, flags);",
   "3185": "    delete pending_file_name_;",
   "3186": "    pending_file_name_ = nullptr;",
   "3187": "}",
   "3188": "",
   "3189": "void FlashCapturer::AddSplitSparsePartition(const std::string& name, std::vector<SparsePtr>& files, size_t flags) {",
   "3190": "    std::cerr << \"FlashCapturer: AddSplitSparsePartition \" << name << \", \"",
   "3191": "              << files.size() << \" splits\" << '\\n';",
   "3192": "    for (size_t i = 0; i < files.size(); i++) {",
   "3193": "        std::string file_name = (name + \"_\").append(std::to_string(i + 1)).append(\".img\");",
   "3194": "        AddSparseFileInner(files[i].get(), file_name, flags);",
   "3195": "        std::string cmd = (\"flash \" + name).append(\" \").append(file_name);",
   "3196": "        AddCommand(cmd);",
   "3197": "        AddShBatLine((\"echo Flashing \" + name).append(\", \")",
   "3198": "            .append(std::to_string(i + 1)).append(\"/\").append(std::to_string(files.size())));",
   "3199": "        AddShBatCommand(\"fastboot \" + cmd);",
   "3200": "    }",
   "3201": "}",
   "3202": "",
   "3203": "void FlashCapturer::SetOutputZipOuterDirName(const std::string& name) {",
   "3204": "    if (!output_zip_outer_dir_name_.empty()) {",
   "3205": "        die(\"output_zip_outer_dir_name is already set\");",
   "3206": "    }",
   "3207": "    output_zip_outer_dir_name_ = name;",
   "3208": "}",
   "3209": "",
   "3210": "void FlashCapturer::StartOutputZipEntry(const std::string& name, size_t flags) {",
   "3211": "    std::string path = output_zip_outer_dir_name_ + \"/\" + name;",
   "3212": "    if (int ret = output_zip_writer_->StartEntry(path, flags)) {",
   "3213": "        die(\"StartOutputZipEntry(%s): %s\", path.c_str(), ErrorCodeString(ret));",
   "3214": "    }",
   "3215": "}",
   "3216": "",
   "3217": "void FlashCapturer::FinishOutputZipEntry() {",
   "3218": "    if (int ret = output_zip_writer_->FinishEntry()) {",
   "3219": "        die(\"FinishOutputZipEntry: %s\", ErrorCodeString(ret));",
   "3220": "    }"
  },
